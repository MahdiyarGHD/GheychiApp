<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Gheychi.Infrastructure</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.ML" Version="5.0.0" />
        <PackageReference Include="Microsoft.ML.FastTree" Version="5.0.0" />
        <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
        <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
        <!-- The native SQLite of 2.1.11 is 3.49.1 (GHSA-2m69-gcr7-jv3q); bundle_green has no newer release, so its native libraries are pinned directly. -->
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Gheychi.Core\Gheychi.Core.csproj" />
    </ItemGroup>

</Project>
