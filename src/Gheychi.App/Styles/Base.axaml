<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Gheychi.App"
        xmlns:theme="clr-namespace:Gheychi.App.Theming"
        xmlns:ui="clr-namespace:Gheychi.App.Ui">

    <!-- A text box with no chrome, for inputs that sit inside a rounded bar of their own. -->
    <Style Selector="TextBox.plain">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.plain:pointerover /template/ Border#border, TextBox.plain:focus /template/ Border#border, TextBox.plain:disabled /template/ Border#border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="ui:TextMenu.Enabled" Value="True" />
    </Style>
    <Style Selector="FlyoutPresenter.textmenu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.textmenu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}" />
        <Setter Property="FontFamily" Value="{x:Static app:AppFonts.Bold}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.textmenu:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.textmenu:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{theme:ThemeBrush Light=#E8EDE6, Dark=#32363E}" />
    </Style>
</Styles>
