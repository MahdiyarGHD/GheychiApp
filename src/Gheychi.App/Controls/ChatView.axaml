<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Gheychi.App"
             xmlns:c="clr-namespace:Gheychi.App.Controls"
             xmlns:loc="clr-namespace:Gheychi.App.Localization"
             xmlns:theme="clr-namespace:Gheychi.App.Theming"
             xmlns:ui="clr-namespace:Gheychi.App.Ui"
             xmlns:vm="clr-namespace:Gheychi.App.ViewModels"
             x:Class="Gheychi.App.Controls.ChatView"
             x:DataType="vm:ChatViewModel">

    <UserControl.Resources>
        <!--
            Message row templates. The list builds a row once per kind and re-binds it to the next message of that kind
            (see ChatList), so what counts is the number of bindings per row, not the number of elements. Rare content
            (links) has its own template, and state that changes while a row is bound (delivery, reaction, selection)
            is one bound property each. The row's own columns and rows carry the old padding so the whole slot is a tap
            target; taps and holds are handled once, on the list.
        -->
        <DataTemplate x:Key="IncomingTemplate" x:DataType="vm:ChatMessage">
            <Grid Background="Transparent"
                  ColumnDefinitions="12,Auto,0.8*,0.2*,12"
                  RowDefinitions="3,Auto,4">
                <Border Grid.Row="1" Grid.Column="1"
                        Width="22" Height="22"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        CornerRadius="11"
                        BorderThickness="1.5"
                        IsVisible="{Binding IsSelectionMode}"
                        Background="{Binding SelectionFill}"
                        BorderBrush="{Binding SelectionStroke}">
                    <TextBlock Text="✓"
                               FontSize="12"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsSelected}" />
                </Border>

                <StackPanel Grid.Row="1" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Spacing="{Binding RowSpacingForReaction}">
                    <Panel>
                        <c:BubbleBorder Tag="bubble"
                                        Padding="{Binding BubblePadding}"
                                        BorderBrush="{Binding SearchStroke}"
                                        StrokeThickness="{Binding SearchStrokeThickness}"
                                        CornerRadius="16"
                                        Background="{theme:ThemeBrush Light=#EDF1EB, Dark=#1C1F24}"
                                        HorizontalAlignment="Left">
                            <TextBlock Text="{Binding BodyBeforeLink}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}" />
                        </c:BubbleBorder>

                        <Border Tag="reaction"
                                IsVisible="{Binding HasReaction}"
                                BorderThickness="1"
                                BorderBrush="{theme:ThemeBrush Light=#E2E8DF, Dark=#2A2E35}"
                                CornerRadius="12"
                                Background="{theme:ThemeBrush Light=#EDF1EB, Dark=#1C1F24}"
                                Padding="6,2"
                                Margin="8,0,0,-8"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding ReactionText}"
                                       Foreground="{Binding ReactionTextColor}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Panel>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Time}"
                                   FontSize="11"
                                   Foreground="#8A8F98"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="★"
                                   FontSize="11"
                                   Foreground="#F59E0B"
                                   IsVisible="{Binding IsStarred}"
                                   VerticalAlignment="Center" />
                        <Border IsVisible="{Binding SimTagVisible}"
                                Padding="5,1"
                                CornerRadius="6"
                                Background="{Binding SimTagBgColor}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SimTagText}"
                                       FontSize="9.5"
                                       FontFamily="{x:Static app:AppFonts.Bold}"
                                       Foreground="{Binding SimTagTextColor}"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Incoming message that contains a link: same row, formatted text with the link underlined -->
        <DataTemplate x:Key="IncomingLinkTemplate" x:DataType="vm:ChatMessage">
            <Grid Background="Transparent"
                  ColumnDefinitions="12,Auto,0.8*,0.2*,12"
                  RowDefinitions="3,Auto,4">
                <Border Grid.Row="1" Grid.Column="1"
                        Width="22" Height="22"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        CornerRadius="11"
                        BorderThickness="1.5"
                        IsVisible="{Binding IsSelectionMode}"
                        Background="{Binding SelectionFill}"
                        BorderBrush="{Binding SelectionStroke}">
                    <TextBlock Text="✓"
                               FontSize="12"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsSelected}" />
                </Border>

                <StackPanel Grid.Row="1" Grid.Column="2"
                            HorizontalAlignment="Left"
                            Spacing="{Binding RowSpacingForReaction}">
                    <Panel>
                        <c:BubbleBorder Tag="bubble"
                                        Padding="{Binding BubblePadding}"
                                        BorderBrush="{Binding SearchStroke}"
                                        StrokeThickness="{Binding SearchStrokeThickness}"
                                        CornerRadius="16"
                                        Background="{theme:ThemeBrush Light=#EDF1EB, Dark=#1C1F24}"
                                        HorizontalAlignment="Left">
                            <TextBlock FontSize="13" TextWrapping="Wrap">
                                <Run Text="{Binding BodyBeforeLink}"
                                     Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}" />
                                <Run Text="{Binding Link}"
                                     Foreground="{StaticResource AccentTextBrush}"
                                     TextDecorations="Underline" />
                            </TextBlock>
                        </c:BubbleBorder>

                        <Border Tag="reaction"
                                IsVisible="{Binding HasReaction}"
                                BorderThickness="1"
                                BorderBrush="{theme:ThemeBrush Light=#E2E8DF, Dark=#2A2E35}"
                                CornerRadius="12"
                                Background="{theme:ThemeBrush Light=#EDF1EB, Dark=#1C1F24}"
                                Padding="6,2"
                                Margin="8,0,0,-8"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding ReactionText}"
                                       Foreground="{Binding ReactionTextColor}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Panel>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Time}"
                                   FontSize="11"
                                   Foreground="#8A8F98"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="★"
                                   FontSize="11"
                                   Foreground="#F59E0B"
                                   IsVisible="{Binding IsStarred}"
                                   VerticalAlignment="Center" />
                        <Border IsVisible="{Binding SimTagVisible}"
                                Padding="5,1"
                                CornerRadius="6"
                                Background="{Binding SimTagBgColor}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SimTagText}"
                                       FontSize="9.5"
                                       FontFamily="{x:Static app:AppFonts.Bold}"
                                       Foreground="{Binding SimTagTextColor}"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OutgoingTemplate" x:DataType="vm:ChatMessage">
            <Grid Background="Transparent"
                  ColumnDefinitions="12,Auto,0.2*,0.8*,12"
                  RowDefinitions="3,Auto,4">
                <Border Grid.Row="1" Grid.Column="1"
                        Width="22" Height="22"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        CornerRadius="11"
                        BorderThickness="1.5"
                        IsVisible="{Binding IsSelectionMode}"
                        Background="{Binding SelectionFill}"
                        BorderBrush="{Binding SelectionStroke}">
                    <TextBlock Text="✓"
                               FontSize="12"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsSelected}" />
                </Border>

                <StackPanel Grid.Row="1" Grid.Column="3"
                            HorizontalAlignment="Right"
                            Spacing="{Binding RowSpacingForReaction}">
                    <Panel>
                        <c:BubbleBorder Tag="bubble"
                                        Padding="{Binding BubblePadding}"
                                        BorderBrush="{Binding SearchStroke}"
                                        StrokeThickness="{Binding SearchStrokeThickness}"
                                        CornerRadius="16"
                                        Background="{StaticResource PrimaryBrush}"
                                        HorizontalAlignment="Right">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding BodyBeforeLink}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="White" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                    <TextBlock Text="★"
                                               FontSize="11"
                                               Foreground="#FCD34D"
                                               IsVisible="{Binding IsStarred}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Time}"
                                               FontSize="11"
                                               Foreground="#BFE8D2"
                                               VerticalAlignment="Bottom" />
                                    <c:SendingSpinner IsVisible="{Binding IsSending}"
                                                      Margin="4,0,0,0"
                                                      Foreground="#BFE8D2"
                                                      VerticalAlignment="Bottom" />
                                    <Panel Margin="2,0,0,1"
                                           VerticalAlignment="Bottom"
                                           IsVisible="{Binding HasTick}">
                                        <ui:Icon Data="{StaticResource Icon.Check}"
                                                 Width="13" Height="13"
                                                 HorizontalAlignment="Left"
                                                 Foreground="{StaticResource MintBrush}" />
                                        <ui:Icon Data="{StaticResource Icon.Check}"
                                                 Width="13" Height="13"
                                                 Margin="5,0,0,0"
                                                 HorizontalAlignment="Left"
                                                 IsVisible="{Binding HasDoubleTick}"
                                                 Foreground="{StaticResource MintBrush}" />
                                    </Panel>
                                </StackPanel>
                            </StackPanel>
                        </c:BubbleBorder>

                        <Border Tag="reaction"
                                IsVisible="{Binding HasReaction}"
                                BorderThickness="1"
                                BorderBrush="{theme:ThemeBrush Light=#E2E8DF, Dark=#2A2E35}"
                                CornerRadius="12"
                                Background="{theme:ThemeBrush Light=#EDF1EB, Dark=#1C1F24}"
                                Padding="6,2"
                                Margin="0,0,8,-8"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Right">
                            <TextBlock Text="{Binding ReactionText}"
                                       Foreground="{Binding ReactionTextColor}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Panel>

                    <StackPanel Tag="failed"
                                Orientation="Horizontal"
                                Spacing="5"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                IsVisible="{Binding HasFailed}">
                        <ui:Icon Data="{StaticResource Icon.Failed}"
                                 Width="14" Height="14"
                                 Foreground="{StaticResource DangerBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Translate Chat_NotDelivered}"
                                   FontSize="12"
                                   Foreground="{StaticResource DangerBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Outgoing message that contains a link: the link used to be dropped from the bubble -->
        <DataTemplate x:Key="OutgoingLinkTemplate" x:DataType="vm:ChatMessage">
            <Grid Background="Transparent"
                  ColumnDefinitions="12,Auto,0.2*,0.8*,12"
                  RowDefinitions="3,Auto,4">
                <Border Grid.Row="1" Grid.Column="1"
                        Width="22" Height="22"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        CornerRadius="11"
                        BorderThickness="1.5"
                        IsVisible="{Binding IsSelectionMode}"
                        Background="{Binding SelectionFill}"
                        BorderBrush="{Binding SelectionStroke}">
                    <TextBlock Text="✓"
                               FontSize="12"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsSelected}" />
                </Border>

                <StackPanel Grid.Row="1" Grid.Column="3"
                            HorizontalAlignment="Right"
                            Spacing="{Binding RowSpacingForReaction}">
                    <Panel>
                        <c:BubbleBorder Tag="bubble"
                                        Padding="{Binding BubblePadding}"
                                        BorderBrush="{Binding SearchStroke}"
                                        StrokeThickness="{Binding SearchStrokeThickness}"
                                        CornerRadius="16"
                                        Background="{StaticResource PrimaryBrush}"
                                        HorizontalAlignment="Right">
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="13" TextWrapping="Wrap">
                                    <Run Text="{Binding BodyBeforeLink}" Foreground="White" />
                                    <Run Text="{Binding Link}"
                                         Foreground="#E3F8EC"
                                         TextDecorations="Underline" />
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                    <TextBlock Text="★"
                                               FontSize="11"
                                               Foreground="#FCD34D"
                                               IsVisible="{Binding IsStarred}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Time}"
                                               FontSize="11"
                                               Foreground="#BFE8D2"
                                               VerticalAlignment="Bottom" />
                                    <c:SendingSpinner IsVisible="{Binding IsSending}"
                                                      Margin="4,0,0,0"
                                                      Foreground="#BFE8D2"
                                                      VerticalAlignment="Bottom" />
                                    <Panel Margin="2,0,0,1"
                                           VerticalAlignment="Bottom"
                                           IsVisible="{Binding HasTick}">
                                        <ui:Icon Data="{StaticResource Icon.Check}"
                                                 Width="13" Height="13"
                                                 HorizontalAlignment="Left"
                                                 Foreground="{StaticResource MintBrush}" />
                                        <ui:Icon Data="{StaticResource Icon.Check}"
                                                 Width="13" Height="13"
                                                 Margin="5,0,0,0"
                                                 HorizontalAlignment="Left"
                                                 IsVisible="{Binding HasDoubleTick}"
                                                 Foreground="{StaticResource MintBrush}" />
                                    </Panel>
                                </StackPanel>
                            </StackPanel>
                        </c:BubbleBorder>

                        <Border Tag="reaction"
                                IsVisible="{Binding HasReaction}"
                                BorderThickness="1"
                                BorderBrush="{theme:ThemeBrush Light=#E2E8DF, Dark=#2A2E35}"
                                CornerRadius="12"
                                Background="{theme:ThemeBrush Light=#EDF1EB, Dark=#1C1F24}"
                                Padding="6,2"
                                Margin="0,0,8,-8"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Right">
                            <TextBlock Text="{Binding ReactionText}"
                                       Foreground="{Binding ReactionTextColor}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Panel>

                    <StackPanel Tag="failed"
                                Orientation="Horizontal"
                                Spacing="5"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                IsVisible="{Binding HasFailed}">
                        <ui:Icon Data="{StaticResource Icon.Failed}"
                                 Width="14" Height="14"
                                 Foreground="{StaticResource DangerBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Translate Chat_NotDelivered}"
                                   FontSize="12"
                                   Foreground="{StaticResource DangerBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DateSeparatorTemplate" x:DataType="vm:DateSeparatorItem">
            <Border Margin="0,8,0,4"
                    Padding="12,4"
                    CornerRadius="11"
                    Background="{theme:ThemeBrush Light=#E8EDE6, Dark=#1C1F24}"
                    HorizontalAlignment="Center">
                <TextBlock Text="{Binding Text}"
                           FontSize="11"
                           Foreground="#8A8F98" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="UnreadSeparatorTemplate" x:DataType="vm:UnreadSeparatorItem">
            <Grid Margin="16,8" ColumnDefinitions="*,Auto,*" VerticalAlignment="Center">
                <Border Grid.Column="0" Height="1" Background="#802E6B4C" VerticalAlignment="Center" />
                <Border Grid.Column="1"
                        Margin="8,0"
                        Padding="12,4"
                        BorderThickness="1"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        CornerRadius="11"
                        Background="{theme:ThemeBrush Light=#EBF3EE, Dark=#142B1F}">
                    <TextBlock Text="{Binding Text}"
                               FontSize="11"
                               FontFamily="{x:Static app:AppFonts.Bold}"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center" />
                </Border>
                <Border Grid.Column="2" Height="1" Background="#802E6B4C" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <vm:ChatTemplateSelector x:Key="ChatSelector"
                                 IncomingTemplate="{StaticResource IncomingTemplate}"
                                 IncomingLinkTemplate="{StaticResource IncomingLinkTemplate}"
                                 OutgoingTemplate="{StaticResource OutgoingTemplate}"
                                 OutgoingLinkTemplate="{StaticResource OutgoingLinkTemplate}"
                                 DateSeparatorTemplate="{StaticResource DateSeparatorTemplate}"
                                 UnreadSeparatorTemplate="{StaticResource UnreadSeparatorTemplate}" />
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="PageContent"
              Focusable="True"
              RowDefinitions="Auto,*,Auto"
              Background="{theme:ThemeBrush Light=#F6F8F4, Dark=#0A1A11}">

            <!-- Row 0: Dual Header (Normal vs Selection Contextual Header) -->
            <Grid Grid.Row="0">
                <!-- Normal Header -->
                <Grid IsVisible="{Binding IsNotSelectionMode}"
                      Margin="8,10"
                      ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                      ColumnSpacing="10">
                    <Panel Grid.Column="0"
                           Width="24" Height="24"
                           VerticalAlignment="Center"
                           Background="Transparent"
                           AutomationProperties.Name="{loc:Translate Chat_Back}"
                           Tapped="OnBack">
                        <ui:Icon Data="{StaticResource Icon.Back}"
                                 Width="24" Height="24"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}" />
                    </Panel>
                    <Border Grid.Column="1"
                            Width="40" Height="40"
                            CornerRadius="20"
                            Background="{theme:ThemeBrush Light=#E3E9E4, Dark=#35423C}"
                            Tapped="OnHeaderTapped">
                        <Panel>
                            <ui:Icon IsVisible="{Binding Thread.HasIcon}"
                                     Data="{Binding Thread.IconFile, Converter={x:Static ui:IconFileConverter.Instance}}"
                                     Width="22" Height="22"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{theme:ThemeBrush Light=#33443C, Dark=#D9E3DD}" />
                            <TextBlock IsVisible="{Binding Thread.HasNoIcon}"
                                       Text="{Binding Thread.Initials}"
                                       Foreground="{theme:ThemeBrush Light=#1B5E43, Dark=#8FE0BE}"
                                       FontSize="14"
                                       FontFamily="{x:Static app:AppFonts.Bold}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center" />
                        </Panel>
                    </Border>
                    <StackPanel Grid.Column="2"
                                Spacing="1"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Tapped="OnHeaderTapped">
                        <TextBlock Text="{Binding Thread.Name}"
                                   Foreground="{theme:ThemeBrush Light=#000000, Dark=#FFFFFF}"
                                   FontSize="15"
                                   FontFamily="{x:Static app:AppFonts.Bold}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                        <TextBlock Text="{Binding Thread.Phone}"
                                   FontSize="12"
                                   Foreground="#8A8F98"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                    </StackPanel>
                    <Panel Grid.Column="3"
                           Width="40" Height="40"
                           VerticalAlignment="Center"
                           IsVisible="{Binding Thread.CanCall}"
                           Background="Transparent"
                           AutomationProperties.Name="{loc:Translate Chat_Call}"
                           Tapped="OnHeaderCallTapped">
                        <ui:Icon Data="{StaticResource Icon.Phone}"
                                 Width="22" Height="22"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="{theme:ThemeBrush Light=#1B5E43, Dark=#8FE0BE}" />
                    </Panel>
                    <Panel Grid.Column="4"
                           Width="40" Height="40"
                           VerticalAlignment="Center"
                           Background="Transparent"
                           AutomationProperties.Name="{loc:Translate Chat_MoreOptions}"
                           Tapped="OnHeaderMenuTapped">
                        <ui:Icon Data="{StaticResource Icon.MoreVert}"
                                 Width="22" Height="22"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="{theme:ThemeBrush Light=#5E665F, Dark=#9AA0AB}" />
                    </Panel>
                </Grid>

                <!-- Selection Contextual Header -->
                <Border IsVisible="{Binding IsSelectionMode}"
                        Padding="12,10"
                        Background="{theme:ThemeBrush Light=#F6F8F4, Dark=#0A1A11}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
                          ColumnSpacing="14">
                        <Panel Grid.Column="0"
                               Width="24" Height="24"
                               VerticalAlignment="Center"
                               Background="Transparent"
                               Tapped="OnExitSelectionMode">
                            <ui:Icon Data="{StaticResource Icon.Close}"
                                     Width="20" Height="20"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}" />
                        </Panel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedCountText}"
                                   FontSize="16"
                                   FontFamily="{x:Static app:AppFonts.Bold}"
                                   VerticalAlignment="Center"
                                   Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}" />
                        <Panel Grid.Column="2"
                               Width="24" Height="24"
                               VerticalAlignment="Center"
                               Background="Transparent"
                               AutomationProperties.Name="{loc:Translate Chat_SelectAll}"
                               Tapped="OnSelectAllTapped">
                            <ui:Icon Data="{StaticResource Icon.Checklist}"
                                     Width="20" Height="20"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{theme:ThemeBrush Light=#5E665F, Dark=#9AA0AB}" />
                        </Panel>
                        <Panel Grid.Column="3"
                               Width="24" Height="24"
                               VerticalAlignment="Center"
                               Background="Transparent"
                               AutomationProperties.Name="{loc:Translate Chat_CopyText}"
                               Tapped="OnCopySelectedTapped">
                            <ui:Icon Data="{StaticResource Icon.Copy}"
                                     Width="19" Height="19"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{theme:ThemeBrush Light=#5E665F, Dark=#9AA0AB}" />
                        </Panel>
                        <Panel Grid.Column="4"
                               Width="24" Height="24"
                               VerticalAlignment="Center"
                               Background="Transparent"
                               AutomationProperties.Name="{loc:Translate Chat_Star}"
                               Tapped="OnStarSelectedTapped">
                            <ui:Icon Data="{StaticResource Icon.Star}"
                                     Width="20" Height="20"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{theme:ThemeBrush Light=#5E665F, Dark=#9AA0AB}" />
                        </Panel>
                        <Panel Grid.Column="5"
                               Width="24" Height="24"
                               VerticalAlignment="Center"
                               Background="Transparent"
                               AutomationProperties.Name="{loc:Translate Chat_Delete}"
                               Tapped="OnDeleteSelectedTapped">
                            <ui:Icon Data="{StaticResource Icon.Trash}"
                                     Width="20" Height="20"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="#EF4444" />
                        </Panel>
                    </Grid>
                </Border>

                <!-- In-chat search header: covers the other two headers while a search is open -->
                <Border x:Name="SearchHeader"
                        IsVisible="False"
                        Padding="8,8,10,8"
                        Background="{theme:ThemeBrush Light=#F6F8F4, Dark=#0A1A11}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                          ColumnSpacing="4">
                        <Panel Grid.Column="0"
                               Width="40" Height="40"
                               VerticalAlignment="Center"
                               Background="Transparent"
                               AutomationProperties.Name="{loc:Translate Chat_Back}"
                               Tapped="OnSearchBackTapped">
                            <ui:Icon Data="{StaticResource Icon.Back}"
                                     Width="22" Height="22"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}" />
                        </Panel>
                        <Border Grid.Column="1"
                                Padding="14,0,12,0"
                                Height="40"
                                CornerRadius="20"
                                Background="{theme:ThemeBrush Light=#E8EDE6, Dark=#1C1F24}"
                                VerticalAlignment="Center">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                <TextBox x:Name="SearchEntry"
                                         Grid.Column="0"
                                         Classes="plain"
                                         PlaceholderText="{loc:Translate Chat_SearchHint}"
                                         PlaceholderForeground="#8A8F98"
                                         Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}"
                                         FontSize="14"
                                         VerticalAlignment="Center"
                                         TextChanged="OnSearchTextChanged"
                                         KeyDown="OnSearchKeyDown" />
                                <Panel x:Name="SearchClear"
                                       Grid.Column="1"
                                       Width="24" Height="24"
                                       IsVisible="False"
                                       VerticalAlignment="Center"
                                       Background="Transparent"
                                       Tapped="OnSearchClearTapped">
                                    <ui:Icon Data="{StaticResource Icon.Close}"
                                             Width="16" Height="16"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Foreground="{theme:ThemeBrush Light=#5E665F, Dark=#9AA0AB}" />
                                </Panel>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Search.CounterText}"
                                           FontSize="12"
                                           Foreground="{theme:ThemeBrush Light=#5E665F, Dark=#9AA0AB}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Panel Grid.Column="2"
                               Width="40" Height="40"
                               VerticalAlignment="Center"
                               Background="Transparent"
                               IsEnabled="{Binding Search.CanNavigate}"
                               AutomationProperties.Name="{loc:Translate Chat_SearchOlder}"
                               Tapped="OnSearchOlderTapped">
                            <ui:Icon Data="{StaticResource Icon.Back}"
                                     RenderTransform="rotate(90deg)"
                                     Width="20" Height="20"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}" />
                        </Panel>
                        <Panel Grid.Column="3"
                               Width="40" Height="40"
                               VerticalAlignment="Center"
                               Background="Transparent"
                               IsEnabled="{Binding Search.CanNavigate}"
                               AutomationProperties.Name="{loc:Translate Chat_SearchNewer}"
                               Tapped="OnSearchNewerTapped">
                            <ui:Icon Data="{StaticResource Icon.Back}"
                                     RenderTransform="rotate(270deg)"
                                     Width="20" Height="20"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}" />
                        </Panel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <!--
                    Bottom-anchored: the list is as tall as its rows until they fill the page, so a short chat sits
                    on the composer. The newest row is last and the view scrolls the panel to it.
                -->
                <c:ChatList x:Name="MessagesList"
                            VerticalAlignment="Bottom"
                            ItemsSource="{Binding Items}"
                            Rows="{StaticResource ChatSelector}">
                    <c:ChatList.Template>
                        <ControlTemplate>
                            <ScrollViewer x:Name="PART_Scroll"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Hidden">
                                <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </ControlTemplate>
                    </c:ChatList.Template>
                    <c:ChatList.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </c:ChatList.ItemsPanel>
                </c:ChatList>

                <Border Margin="0,8,0,0"
                        Padding="12,4"
                        CornerRadius="11"
                        Background="{theme:ThemeBrush Light=#E8EDE6, Dark=#1C1F24}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        IsVisible="{Binding HasStickyDate}"
                        IsHitTestVisible="False">
                    <TextBlock Text="{Binding StickyDate}"
                               FontSize="11"
                               Foreground="#8A8F98" />
                </Border>

                <StackPanel x:Name="SkeletonOverlay"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Margin="12,16"
                            Spacing="14"
                            VerticalAlignment="Bottom">
                    <Border Width="210" Height="42"
                            CornerRadius="16"
                            Background="{theme:ThemeBrush Light=#E2E8DF, Dark=#1C1F24}"
                            HorizontalAlignment="Left" />
                    <Border Width="180" Height="52"
                            CornerRadius="16"
                            Background="{theme:ThemeBrush Light=#D0E6DA, Dark=#173827}"
                            HorizontalAlignment="Right" />
                    <Border Width="260" Height="46"
                            CornerRadius="16"
                            Background="{theme:ThemeBrush Light=#E2E8DF, Dark=#1C1F24}"
                            HorizontalAlignment="Left" />
                    <Border Width="230" Height="42"
                            CornerRadius="16"
                            Background="{theme:ThemeBrush Light=#D0E6DA, Dark=#173827}"
                            HorizontalAlignment="Right" />
                    <Border Width="160" Height="38"
                            CornerRadius="16"
                            Background="{theme:ThemeBrush Light=#E2E8DF, Dark=#1C1F24}"
                            HorizontalAlignment="Left" />
                </StackPanel>

                <Border x:Name="ScrollToBottomButton"
                        Margin="0,0,16,16"
                        Width="40" Height="40"
                        CornerRadius="20"
                        Background="{theme:ThemeBrush Light=#FFFFFF, Dark=#1C1F24}"
                        BoxShadow="0 2 4 0 #4D000000"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        IsVisible="False"
                        Opacity="0"
                        Tapped="OnScrollToBottomTapped">
                    <ui:Icon Data="{StaticResource Icon.Back}"
                             RenderTransform="rotate(270deg)"
                             Width="18" Height="18"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}" />
                </Border>
            </Grid>

            <!-- Row 2: Bottom SMS Input Bar (Hidden in selection mode); for a blocked sender, the way to unblock -->
            <Grid Grid.Row="2"
                  IsVisible="{Binding IsInputBarVisible}"
                  Margin="10,6,10,8">
                <Border x:Name="BlockedBar"
                        IsVisible="False"
                        Padding="16,9"
                        CornerRadius="18"
                        Background="{theme:ThemeBrush Light=#E8EDE6, Dark=#1C1F24}"
                        Tapped="OnUnblockTapped">
                    <StackPanel Spacing="1" HorizontalAlignment="Center">
                        <TextBlock Text="{loc:Translate Chat_Unblock}"
                                   FontSize="14"
                                   FontFamily="{x:Static app:AppFonts.Bold}"
                                   Foreground="{theme:ThemeBrush Light=#1B5E43, Dark=#8FE0BE}"
                                   TextAlignment="Center" />
                        <TextBlock Text="{loc:Translate Chat_BlockedHint}"
                                   FontSize="11"
                                   Foreground="#8A8F98"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>
                <Grid x:Name="Composer" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                    <Border Grid.Column="0"
                            Width="40" Height="40"
                            CornerRadius="20"
                            Background="{theme:ThemeBrush Light=#E8EDE6, Dark=#1C1F24}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{loc:Translate Chat_Attach}">
                        <ui:Icon Data="{StaticResource Icon.Plus}"
                                 Width="16" Height="16"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="{theme:ThemeBrush Light=#5E665F, Dark=#9AA0AB}" />
                    </Border>
                    <Border Grid.Column="1"
                            Padding="12,0"
                            MinHeight="44"
                            CornerRadius="22"
                            Background="{theme:ThemeBrush Light=#E8EDE6, Dark=#1C1F24}"
                            VerticalAlignment="Center"
                            Tapped="OnInputBarTapped">
                        <TextBox x:Name="MessageEntry"
                                 Classes="plain"
                                 VerticalAlignment="Stretch"
                                 Padding="0,10"
                                 Text="{Binding Draft}"
                                 PlaceholderText="{loc:Translate Chat_MessageHint}"
                                 PlaceholderForeground="#8A8F98"
                                 Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}"
                                 FontSize="13"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MaxHeight="100"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <Border Grid.Column="2"
                            Width="40" Height="40"
                            CornerRadius="20"
                            Background="{Binding SimBadgeColor}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{loc:Translate Chat_Sim}"
                            Tapped="OnSimTap">
                        <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:Icon Data="{StaticResource Icon.SimOutline}"
                                     Width="28" Height="28"
                                     Foreground="White" />
                            <TextBlock x:Name="SimDigit"
                                       Text="{Binding SimText}"
                                       FontSize="11"
                                       FontFamily="{x:Static app:AppFonts.Bold}"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center" />
                        </Panel>
                    </Border>
                    <Border Grid.Column="3"
                            Width="42" Height="42"
                            CornerRadius="21"
                            Background="{StaticResource PrimaryBrush}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{loc:Translate Chat_Send}"
                            Tapped="OnSend">
                        <ui:Icon Data="{StaticResource Icon.Send}"
                                 Margin="0,3,0,0"
                                 Width="18" Height="18"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="White" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Header menu (three dots): a tap outside it closes it -->
        <Grid x:Name="HeaderMenuOverlay"
              IsVisible="False"
              Background="Transparent"
              Tapped="OnCloseHeaderMenuTapped">
            <Border Margin="0,54,12,0"
                    Padding="4"
                    Width="200"
                    BorderThickness="1"
                    BorderBrush="{theme:ThemeBrush Light=#E2E8DF, Dark=#2A2E35}"
                    CornerRadius="12"
                    Background="{theme:ThemeBrush Light=#FFFFFF, Dark=#1C1F24}"
                    BoxShadow="0 6 16 0 #40000000"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Tapped="OnMenuTapEater">
                <Border Padding="12,11"
                        Background="Transparent"
                        Tapped="OnMenuSearchTapped">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <ui:Icon Grid.Column="0"
                                 Data="{StaticResource Icon.Search}"
                                 Width="18" Height="18"
                                 VerticalAlignment="Center"
                                 Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}" />
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Translate Chat_Search}"
                                   FontSize="13"
                                   FontFamily="{x:Static app:AppFonts.Bold}"
                                   Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- ================= LAYER 2 & 3: FLOATING SELECTION OVERLAY ================= -->
        <Grid x:Name="SelectionOverlay"
              IsVisible="False"
              Opacity="0">
            <!-- Layer 2: Backdrop Scrim -->
            <Border Background="{theme:ThemeBrush Light=#73000000, Dark=#A6000000}"
                    Tapped="OnDismissSelectionOverlay" />

            <!-- Layer 3: Interactive Floating Group -->
            <ScrollViewer Background="Transparent"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          Tapped="OnDismissSelectionOverlay">
                <StackPanel x:Name="OverlayContent"
                            Margin="16,24"
                            VerticalAlignment="Center">
                    <!-- 1. Floating Quick Reactions Dock -->
                    <Border x:Name="ReactionDock"
                            BorderThickness="1"
                            BorderBrush="{theme:ThemeBrush Light=#E2E8DF, Dark=#2A2E35}"
                            CornerRadius="24"
                            Background="{theme:ThemeBrush Light=#FFFFFF, Dark=#1C1F24}"
                            Padding="10,6"
                            Margin="4,0,4,10"
                            BoxShadow="0 4 12 0 #33000000"
                            HorizontalAlignment="Left"
                            Tapped="OnMenuTapEater">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="👍" FontSize="20" Padding="5,2" Background="Transparent" VerticalAlignment="Center" Tapped="OnReactionThumbTapped" />
                            <TextBlock Text="❤️" FontSize="20" Padding="5,2" Background="Transparent" VerticalAlignment="Center" Tapped="OnReactionHeartTapped" />
                            <TextBlock Text="😂" FontSize="20" Padding="5,2" Background="Transparent" VerticalAlignment="Center" Tapped="OnReactionJoyTapped" />
                            <TextBlock Text="👎" FontSize="20" Padding="5,2" Background="Transparent" VerticalAlignment="Center" Tapped="OnReactionDislikeTapped" />
                            <TextBlock Text="‼️" FontSize="20" Padding="5,2" Background="Transparent" VerticalAlignment="Center" Tapped="OnReactionEmphasizeTapped" />
                            <TextBlock Text="❓" FontSize="20" Padding="5,2" Background="Transparent" VerticalAlignment="Center" Tapped="OnReactionQuestionTapped" />
                        </StackPanel>
                    </Border>

                    <!-- 2. The Lifted & Highlighted Focused Message -->
                    <Border x:Name="ElevatedBubbleBorder"
                            Padding="10,7"
                            Margin="4,0"
                            BorderThickness="1.5"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            CornerRadius="16"
                            MaxHeight="240"
                            BoxShadow="0 8 20 0 #4D000000"
                            HorizontalAlignment="Left">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="ElevatedBubbleBody"
                                       FontSize="13"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ElevatedBubbleLink"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource AccentTextBrush}"
                                       TextDecorations="Underline"
                                       IsVisible="False" />
                        </StackPanel>
                    </Border>

                    <!-- Selection Metadata Chip -->
                    <StackPanel x:Name="ElevatedMetadataGroup" Orientation="Horizontal" Spacing="6" Margin="6,6,6,0">
                        <TextBlock x:Name="ElevatedBubbleTime"
                                   FontSize="11"
                                   Foreground="{theme:ThemeBrush Light=#FFFFFF, Dark=#E8EAED}"
                                   VerticalAlignment="Center" />
                        <Border Padding="6,2"
                                CornerRadius="10"
                                Background="{theme:ThemeBrush Light=#FFFFFF, Dark=#1C1F24}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="✓" FontSize="10" Foreground="{StaticResource PrimaryBrush}" FontFamily="{x:Static app:AppFonts.Bold}" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Translate Chat_Selected}"
                                           FontSize="10"
                                           FontFamily="{x:Static app:AppFonts.Bold}"
                                           Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 3. Floating Context Options Popover Menu -->
                    <Border x:Name="ContextActionMenu"
                            Margin="4,14,4,0"
                            Width="260"
                            BorderThickness="1"
                            BorderBrush="{theme:ThemeBrush Light=#E2E8DF, Dark=#2A2E35}"
                            CornerRadius="18"
                            Background="{theme:ThemeBrush Light=#FFFFFF, Dark=#1C1F24}"
                            BoxShadow="0 10 24 0 #4D000000"
                            HorizontalAlignment="Left"
                            Tapped="OnMenuTapEater">
                        <StackPanel Margin="6" Spacing="2">
                            <!-- Copy URL (Only visible when link present) -->
                            <Grid x:Name="CopyUrlActionRow"
                                  ColumnDefinitions="10,Auto,10,*,10,Auto,10"
                                  RowDefinitions="8,Auto,8"
                                  Background="Transparent"
                                  Tapped="OnCopyUrlTapped">
                                <ui:Icon Grid.Row="1" Grid.Column="1" Data="{StaticResource Icon.Link}" Width="18" Height="18" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="3"
                                           Text="{loc:Translate Chat_CopyUrl}"
                                           FontSize="13"
                                           FontFamily="{x:Static app:AppFonts.Bold}"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <Border Grid.Row="1" Grid.Column="5"
                                        Padding="5,1"
                                        CornerRadius="6"
                                        Background="{theme:ThemeBrush Light=#EBF3EE, Dark=#142B1F}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Translate Chat_LinkBadge}"
                                               FontSize="9.5"
                                               FontFamily="{x:Static app:AppFonts.Bold}"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <!-- Copy Text -->
                            <Grid ColumnDefinitions="10,Auto,10,*,10"
                                  RowDefinitions="8,Auto,8"
                                  Background="Transparent"
                                  Tapped="OnCopyTextTapped">
                                <ui:Icon Grid.Row="1" Grid.Column="1" Data="{StaticResource Icon.Copy}" Width="18" Height="18" VerticalAlignment="Center" Foreground="{theme:ThemeBrush Light=#5E665F, Dark=#9AA0AB}" />
                                <TextBlock Grid.Row="1" Grid.Column="3"
                                           Text="{loc:Translate Chat_CopyText}"
                                           FontSize="13"
                                           Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- Star / Unstar -->
                            <Grid ColumnDefinitions="10,Auto,10,*,10"
                                  RowDefinitions="8,Auto,8"
                                  Background="Transparent"
                                  Tapped="OnMenuStarTapped">
                                <ui:Icon x:Name="MenuStarIcon" Grid.Row="1" Grid.Column="1" Data="{StaticResource Icon.Star}" Width="18" Height="18" VerticalAlignment="Center" Foreground="{theme:ThemeBrush Light=#5E665F, Dark=#9AA0AB}" />
                                <TextBlock x:Name="MenuStarLabel"
                                           Grid.Row="1" Grid.Column="3"
                                           Text="{loc:Translate Chat_Star}"
                                           FontSize="13"
                                           Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Border Height="1" Margin="0,3" Background="{theme:ThemeBrush Light=#EEF2EC, Dark=#2A2E35}" />

                            <!-- Select More -->
                            <Grid ColumnDefinitions="10,Auto,10,*,10"
                                  RowDefinitions="8,Auto,8"
                                  Background="Transparent"
                                  Tapped="OnMenuSelectMoreTapped">
                                <ui:Icon Grid.Row="1" Grid.Column="1" Data="{StaticResource Icon.Checklist}" Width="18" Height="18" VerticalAlignment="Center" Foreground="{theme:ThemeBrush Light=#5E665F, Dark=#9AA0AB}" />
                                <TextBlock Grid.Row="1" Grid.Column="3"
                                           Text="{loc:Translate Chat_SelectMore}"
                                           FontSize="13"
                                           Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- Info -->
                            <Grid ColumnDefinitions="10,Auto,10,*,10"
                                  RowDefinitions="8,Auto,8"
                                  Background="Transparent"
                                  Tapped="OnMenuInfoTapped">
                                <ui:Icon Grid.Row="1" Grid.Column="1" Data="{StaticResource Icon.Info}" Width="18" Height="18" VerticalAlignment="Center" Foreground="{theme:ThemeBrush Light=#5E665F, Dark=#9AA0AB}" />
                                <TextBlock Grid.Row="1" Grid.Column="3"
                                           Text="{loc:Translate Chat_Info}"
                                           FontSize="13"
                                           Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- Report as spam: received messages only -->
                            <Grid x:Name="MenuReportRow"
                                  ColumnDefinitions="10,Auto,10,*,10"
                                  RowDefinitions="8,Auto,8"
                                  Background="Transparent"
                                  Tapped="OnMenuReportTapped">
                                <ui:Icon Grid.Row="1" Grid.Column="1" Data="{StaticResource Icon.Report}" Width="18" Height="18" VerticalAlignment="Center" Foreground="{theme:ThemeBrush Light=#5E665F, Dark=#9AA0AB}" />
                                <TextBlock Grid.Row="1" Grid.Column="3"
                                           Text="{loc:Translate Chat_ReportSpam}"
                                           FontSize="13"
                                           Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Border Height="1" Margin="0,3" Background="{theme:ThemeBrush Light=#EEF2EC, Dark=#2A2E35}" />

                            <!-- Delete -->
                            <Grid ColumnDefinitions="10,Auto,10,*,10"
                                  RowDefinitions="8,Auto,8"
                                  Background="Transparent"
                                  Tapped="OnMenuDeleteTapped">
                                <ui:Icon Grid.Row="1" Grid.Column="1" Data="{StaticResource Icon.Trash}" Width="18" Height="18" VerticalAlignment="Center" Foreground="#EF4444" />
                                <TextBlock Grid.Row="1" Grid.Column="3"
                                           Text="{loc:Translate Chat_Delete}"
                                           FontSize="13"
                                           FontFamily="{x:Static app:AppFonts.Bold}"
                                           Foreground="#EF4444"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= MESSAGE INFO SHEET ================= -->
        <Grid x:Name="MessageInfoModal"
              IsVisible="False"
              Opacity="0">
            <Border Background="{theme:ThemeBrush Light=#60000000, Dark=#90000000}"
                    Tapped="OnCloseInfoModalTapped" />
            <Border Margin="24,0"
                    BorderThickness="1"
                    BorderBrush="{theme:ThemeBrush Light=#E2E8DF, Dark=#2A2E35}"
                    CornerRadius="24"
                    Background="{theme:ThemeBrush Light=#FFFFFF, Dark=#1C1F24}"
                    VerticalAlignment="Center"
                    Padding="20,18"
                    BoxShadow="0 10 24 0 #59000000"
                    Tapped="OnMenuTapEater">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{loc:Translate Chat_InfoTitle}"
                                   FontSize="16"
                                   FontFamily="{x:Static app:AppFonts.Bold}"
                                   Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}"
                                   VerticalAlignment="Center" />
                        <Panel Grid.Column="1"
                               Width="24" Height="24"
                               VerticalAlignment="Center"
                               Background="Transparent"
                               Tapped="OnCloseInfoModalTapped">
                            <ui:Icon Data="{StaticResource Icon.Close}"
                                     Width="18" Height="18"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{theme:ThemeBrush Light=#5E665F, Dark=#9AA0AB}" />
                        </Panel>
                    </Grid>

                    <Border Height="1" Background="{theme:ThemeBrush Light=#EEF2EC, Dark=#2A2E35}" />

                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <TextBlock Text="{loc:Translate Chat_InfoType}" FontSize="13" Foreground="#8A8F98" />
                            <TextBlock x:Name="InfoTypeLabel" Grid.Column="1" FontSize="13" FontFamily="{x:Static app:AppFonts.Bold}" Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}" TextAlignment="End" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <TextBlock Text="{loc:Translate Chat_InfoTime}" FontSize="13" Foreground="#8A8F98" />
                            <TextBlock x:Name="InfoTimeLabel" Grid.Column="1" FontSize="13" Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}" TextAlignment="End" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <TextBlock Text="{loc:Translate Chat_InfoStatus}" FontSize="13" Foreground="#8A8F98" />
                            <TextBlock x:Name="InfoStatusLabel" Grid.Column="1" FontSize="13" Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}" TextAlignment="End" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <TextBlock Text="{loc:Translate Chat_InfoSim}" FontSize="13" Foreground="#8A8F98" />
                            <TextBlock x:Name="InfoSimLabel" Grid.Column="1" FontSize="13" Foreground="{theme:ThemeBrush Light=#1B1E24, Dark=#E8EAED}" TextAlignment="End" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
