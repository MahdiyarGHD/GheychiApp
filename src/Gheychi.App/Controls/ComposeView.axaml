<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Gheychi.App"
             xmlns:vm="clr-namespace:Gheychi.App.ViewModels"
             xmlns:loc="clr-namespace:Gheychi.App.Localization"
             xmlns:theme="clr-namespace:Gheychi.App.Theming"
             xmlns:ui="clr-namespace:Gheychi.App.Ui"
             xmlns:ti="using:Avalonia.Input.TextInput"
             x:Class="Gheychi.App.Controls.ComposeView"
             Background="{theme:ThemeBrush Light=#F1F3F4, Dark=#121212}">

    <UserControl.Resources>
        <vm:ComposeRowTemplateSelector x:Key="RowSelector">
            <!-- Section title: a letter or "Recent" -->
            <vm:ComposeRowTemplateSelector.Header>
                <DataTemplate x:DataType="vm:ComposeRow">
                    <TextBlock Text="{Binding Letter, Mode=OneTime}"
                               Margin="22,14,16,4"
                               FontSize="11"
                               LetterSpacing="0.8"
                               FontFamily="{x:Static app:AppFonts.Bold}"
                               Foreground="{theme:ThemeBrush Light=#2E7D5B, Dark=#6FD3A8}" />
                </DataTemplate>
            </vm:ComposeRowTemplateSelector.Header>

            <!-- A person: avatar with initials, name, "Mobile · number" -->
            <vm:ComposeRowTemplateSelector.Contact>
                <DataTemplate x:DataType="vm:ComposeRow">
                    <Grid Height="60" ColumnDefinitions="Auto,*" Background="Transparent">
                        <Border Width="44" Height="44" Margin="16,0,14,0" CornerRadius="22"
                                Background="{theme:ThemeBrush Light=#DCEFE3, Dark=#1F4A35}">
                            <TextBlock Text="{Binding Initials, Mode=OneTime}"
                                       FontSize="19"
                                       FontFamily="{x:Static app:AppFonts.Bold}"
                                       Foreground="{theme:ThemeBrush Light=#1B5E43, Dark=#6FD3A8}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="0,0,18,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name, Mode=OneTime}"
                                       FontSize="15"
                                       FontFamily="{x:Static app:AppFonts.Regular}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{theme:ThemeBrush Light=#3B3D40, Dark=#C9CED4}" />
                            <TextBlock Text="{Binding Subtitle, Mode=OneTime}"
                                       IsVisible="{Binding HasSubtitle, Mode=OneTime}"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{theme:ThemeBrush Light=#64676C, Dark=#9AA0AB}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </vm:ComposeRowTemplateSelector.Contact>

            <!-- A person without letters in the name: a person icon instead of initials -->
            <vm:ComposeRowTemplateSelector.ContactIcon>
                <DataTemplate x:DataType="vm:ComposeRow">
                    <Grid Height="60" ColumnDefinitions="Auto,*" Background="Transparent">
                        <Border Width="44" Height="44" Margin="16,0,14,0" CornerRadius="22"
                                Background="{theme:ThemeBrush Light=#DCEFE3, Dark=#1F4A35}">
                            <ui:Icon Data="{StaticResource Icon.Person}"
                                     Width="23" Height="23"
                                     Foreground="{theme:ThemeBrush Light=#1B5E43, Dark=#6FD3A8}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="0,0,18,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name, Mode=OneTime}"
                                       FontSize="15"
                                       FontFamily="{x:Static app:AppFonts.Regular}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{theme:ThemeBrush Light=#3B3D40, Dark=#C9CED4}" />
                            <TextBlock Text="{Binding Subtitle, Mode=OneTime}"
                                       IsVisible="{Binding HasSubtitle, Mode=OneTime}"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{theme:ThemeBrush Light=#64676C, Dark=#9AA0AB}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </vm:ComposeRowTemplateSelector.ContactIcon>

            <!-- "Send to 0903…": the number typed in the To field -->
            <vm:ComposeRowTemplateSelector.Typed>
                <DataTemplate x:DataType="vm:ComposeRow">
                    <Grid Height="60" ColumnDefinitions="Auto,*" Background="Transparent">
                        <Border Width="44" Height="44" Margin="16,0,14,0" CornerRadius="22"
                                Background="{StaticResource PrimaryBrush}">
                            <ui:Icon Data="{StaticResource Icon.Send}"
                                     Width="21" Height="21"
                                     Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="0,0,18,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name, Mode=OneTime}"
                                       FontSize="15"
                                       FontFamily="{x:Static app:AppFonts.Regular}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{theme:ThemeBrush Light=#3B3D40, Dark=#C9CED4}" />
                            <TextBlock Text="{Binding Subtitle, Mode=OneTime}"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{theme:ThemeBrush Light=#2E7D5B, Dark=#6FD3A8}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </vm:ComposeRowTemplateSelector.Typed>

            <vm:ComposeRowTemplateSelector.FooterSpace>
                <DataTemplate x:DataType="vm:ComposeRow">
                    <Panel Height="24" />
                </DataTemplate>
            </vm:ComposeRowTemplateSelector.FooterSpace>
        </vm:ComposeRowTemplateSelector>
    </UserControl.Resources>

    <Grid x:Name="Root" RowDefinitions="Auto,Auto,*" Focusable="True">

        <!-- Header -->
        <Grid Grid.Row="0" Height="56" ColumnDefinitions="Auto,*" ColumnSpacing="4">
            <Border x:Name="BackButton"
                    Width="40" Height="40"
                    Margin="8,0,0,0"
                    CornerRadius="20"
                    Background="Transparent"
                    VerticalAlignment="Center"
                    Tapped="OnBackTapped"
                    AutomationProperties.Name="{loc:Translate Chat_Back}">
                <ui:Icon Data="{StaticResource Icon.Back}"
                         Width="20" Height="20"
                         Foreground="{theme:ThemeBrush Light=#2E3032, Dark=#E8EAED}" />
            </Border>
            <TextBlock Grid.Column="1"
                       Margin="0,0,12,0"
                       Text="{loc:Translate Compose_Title}"
                       FontSize="22"
                       FontFamily="{x:Static app:AppFonts.Bold}"
                       Foreground="{theme:ThemeBrush Light=#191A1C, Dark=#E8EAED}"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Recipient field -->
        <Border x:Name="RecipientCard"
                Grid.Row="1"
                Margin="14,0,14,14"
                Padding="16,0,6,0"
                Height="46"
                BorderThickness="1.5"
                BorderBrush="Transparent"
                CornerRadius="23"
                Background="{theme:ThemeBrush Light=#E8EAED, Dark=#1E1F22}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                <TextBlock Grid.Column="0"
                           Text="{loc:Translate Compose_To}"
                           FontSize="13"
                           FontFamily="{x:Static app:AppFonts.Bold}"
                           Foreground="{theme:ThemeBrush Light=#2E7D5B, Dark=#6FD3A8}"
                           VerticalAlignment="Center" />
                <TextBox x:Name="RecipientEntry"
                         Grid.Column="1"
                         Classes="plain"
                         PlaceholderText="{loc:Translate Compose_Hint}"
                         PlaceholderForeground="{theme:ThemeBrush Light=#7B8086, Dark=#7F8791}"
                         Foreground="{theme:ThemeBrush Light=#191A1C, Dark=#E8EAED}"
                         FontSize="14"
                         ti:TextInputOptions.ReturnKeyType="Go"
                         VerticalAlignment="Center"
                         TextChanged="OnRecipientTextChanged"
                         KeyDown="OnRecipientKeyDown"
                         GotFocus="OnRecipientFocusChanged"
                         LostFocus="OnRecipientFocusChanged" />
                <Border x:Name="ClearButton"
                        Grid.Column="2"
                        IsVisible="False"
                        Width="30" Height="30"
                        CornerRadius="15"
                        Background="Transparent"
                        VerticalAlignment="Center"
                        Tapped="OnClearTapped"
                        AutomationProperties.Name="{loc:Translate Chat_Cancel}">
                    <ui:Icon Data="{StaticResource Icon.Close}"
                             Width="14" Height="14"
                             Foreground="{theme:ThemeBrush Light=#595C61, Dark=#9AA0AB}" />
                </Border>
                <Border x:Name="SimChip"
                        Grid.Column="3"
                        IsVisible="False"
                        Padding="9,0"
                        Height="28"
                        CornerRadius="14"
                        Background="{theme:ThemeBrush Light=#DCDDDF, Dark=#2D2E30}"
                        VerticalAlignment="Center"
                        Tapped="OnSimChipTapped"
                        AutomationProperties.Name="{loc:Translate Compose_Sim}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ui:Icon Data="{StaticResource Icon.SimCard}"
                                 Width="13" Height="13"
                                 Foreground="{theme:ThemeBrush Light=#2E7D5B, Dark=#6FD3A8}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="SimLabel"
                                   FontSize="11"
                                   FontFamily="{x:Static app:AppFonts.Bold}"
                                   Foreground="{theme:ThemeBrush Light=#3A3C3E, Dark=#D9DADB}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Suggestions and contacts -->
        <Border Grid.Row="2"
                CornerRadius="28,28,0,0"
                ClipToBounds="True"
                Background="{theme:ThemeBrush Light=#FFFFFF, Dark=#1E1F22}">
        <Panel>
            <ItemsControl x:Name="ContactList"
                          Margin="0,8,0,0"
                          ItemTemplate="{StaticResource RowSelector}"
                          Tapped="OnRowTapped">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="PART_Scroller"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <ProgressBar x:Name="LoadingIndicator"
                         IsVisible="False"
                         IsIndeterminate="False"
                         Width="120"
                         Margin="0,56,0,0"
                         VerticalAlignment="Top"
                         HorizontalAlignment="Center" />

            <StackPanel x:Name="EmptyState"
                        IsVisible="False"
                        Spacing="8"
                        Margin="36,48,36,0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center">
                <Border Width="64" Height="64"
                        CornerRadius="32"
                        Background="{theme:ThemeBrush Light=#DCEFE3, Dark=#28292B}"
                        HorizontalAlignment="Center">
                    <ui:Icon Data="{StaticResource Icon.Person}"
                             Width="26" Height="26"
                             Foreground="{theme:ThemeBrush Light=#2E7D5B, Dark=#6FD3A8}" />
                </Border>
                <TextBlock x:Name="EmptyTitle"
                           FontSize="16"
                           FontFamily="{x:Static app:AppFonts.Bold}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{theme:ThemeBrush Light=#191A1C, Dark=#E8EAED}" />
                <TextBlock x:Name="EmptyHint"
                           FontSize="13"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{theme:ThemeBrush Light=#64676C, Dark=#9AA0AB}" />
                <Border x:Name="EmptyAction"
                        IsVisible="False"
                        Margin="0,10,0,0"
                        Padding="22,11"
                        CornerRadius="22"
                        Background="{StaticResource PrimaryBrush}"
                        HorizontalAlignment="Center"
                        Tapped="OnEmptyActionTapped">
                    <TextBlock Text="{loc:Translate Compose_OpenSettings}"
                               FontSize="14"
                               FontFamily="{x:Static app:AppFonts.Bold}"
                               Foreground="White" />
                </Border>
            </StackPanel>
        </Panel>
        </Border>
    </Grid>
</UserControl>
