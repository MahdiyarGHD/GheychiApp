<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Gheychi.App.ViewModels"
             xmlns:loc="clr-namespace:Gheychi.App.Localization"
             xmlns:behaviors="clr-namespace:Gheychi.App.Behaviors"
             x:Class="Gheychi.App.Controls.ComposeView"
             BackgroundColor="{AppThemeBinding Light=#F7FAF4, Dark=#121413}">

    <ContentView.Resources>
        <DataTemplate x:Key="HeaderTemplate" x:DataType="vm:ComposeRow">
            <Label Text="{Binding Letter}"
                   Padding="20,12,16,2"
                   FontSize="12"
                   FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                   TextColor="{StaticResource Primary}" />
        </DataTemplate>

        <DataTemplate x:Key="ContactTemplate" x:DataType="vm:ComposeRow">
            <Grid Padding="16,8"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="14"
                  BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRowTapped" />
                </Grid.GestureRecognizers>
                <Border Grid.Column="0"
                        WidthRequest="46"
                        HeightRequest="46"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 23"
                        BackgroundColor="{AppThemeBinding Light=#E3E9E4, Dark=#35423C}"
                        InputTransparent="True">
                    <Label Text="{Binding Initials}"
                           FontSize="14"
                           FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                           TextColor="{AppThemeBinding Light=#1B5E43, Dark=#8FE0BE}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           InputTransparent="True" />
                </Border>
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center"
                                     InputTransparent="True"
                                     CascadeInputTransparent="True">
                    <Label Text="{Binding Name}"
                           FontSize="15"
                           FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           TextColor="{AppThemeBinding Light=#1A1C19, Dark=#E8EAED}" />
                    <Label Text="{Binding Subtitle}"
                           FontSize="12"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           TextColor="{AppThemeBinding Light=#727970, Dark=#9AA0AB}" />
                </VerticalStackLayout>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TypedTemplate" x:DataType="vm:ComposeRow">
            <Grid Padding="16,8"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="14"
                  BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRowTapped" />
                </Grid.GestureRecognizers>
                <Border Grid.Column="0"
                        WidthRequest="46"
                        HeightRequest="46"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 23"
                        BackgroundColor="{StaticResource Primary}"
                        InputTransparent="True">
                    <Image Source="send.png"
                           WidthRequest="20"
                           HeightRequest="20"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           InputTransparent="True">
                        <Image.Behaviors>
                            <behaviors:IconTintBehavior TintColor="White" />
                        </Image.Behaviors>
                    </Image>
                </Border>
                <Label Grid.Column="1"
                       Text="{Binding Name}"
                       FontSize="15"
                       FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#1A1C19, Dark=#E8EAED}"
                       InputTransparent="True" />
            </Grid>
        </DataTemplate>

        <vm:ComposeRowTemplateSelector x:Key="RowSelector"
                                       HeaderTemplate="{StaticResource HeaderTemplate}"
                                       ContactTemplate="{StaticResource ContactTemplate}"
                                       TypedTemplate="{StaticResource TypedTemplate}" />
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">

        <!-- Header -->
        <Grid Grid.Row="0"
              HeightRequest="60"
              Padding="12,0,16,0"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="8">
            <Border Grid.Column="0"
                    WidthRequest="40"
                    HeightRequest="40"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="Transparent"
                    VerticalOptions="Center"
                    SemanticProperties.Description="{loc:Translate Chat_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Image Source="back.png"
                       WidthRequest="22"
                       HeightRequest="22"
                       HorizontalOptions="Center"
                       VerticalOptions="Center">
                    <Image.Behaviors>
                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#2C342E, Dark=#E8EAED}" />
                    </Image.Behaviors>
                </Image>
            </Border>
            <Label Grid.Column="1"
                   Text="{loc:Translate Compose_Title}"
                   FontSize="20"
                   FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                   TextColor="{AppThemeBinding Light=#1A1C19, Dark=#E8EAED}"
                   VerticalOptions="Center" />
            <Border x:Name="DialpadButton"
                    Grid.Column="2"
                    WidthRequest="40"
                    HeightRequest="40"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="Transparent"
                    VerticalOptions="Center"
                    SemanticProperties.Description="{loc:Translate Compose_Dialpad}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDialpadTapped" />
                </Border.GestureRecognizers>
                <Image Source="dialpad.png"
                       WidthRequest="20"
                       HeightRequest="20"
                       HorizontalOptions="Center"
                       VerticalOptions="Center">
                    <Image.Behaviors>
                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#59615A, Dark=#9AA0AB}" />
                    </Image.Behaviors>
                </Image>
            </Border>
        </Grid>

        <!-- Recipient field -->
        <Grid Grid.Row="1"
              Padding="16,2,16,10">
            <Border Padding="14,0,10,0"
                    HeightRequest="48"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="{AppThemeBinding Light=#F0F5EE, Dark=#1E2320}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                    <Label Grid.Column="0"
                           Text="{loc:Translate Compose_To}"
                           FontSize="12"
                           FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                           TextColor="{StaticResource Primary}"
                           VerticalOptions="Center" />
                    <Entry x:Name="RecipientEntry"
                           Grid.Column="1"
                           Placeholder="{loc:Translate Compose_Hint}"
                           PlaceholderColor="{AppThemeBinding Light=#747D75, Dark=#8A8F98}"
                           TextColor="{AppThemeBinding Light=#1A1C19, Dark=#E8EAED}"
                           BackgroundColor="Transparent"
                           FontSize="14"
                           FontFamily="{DynamicResource AppFontFamily}"
                           ClearButtonVisibility="Never"
                           ReturnType="Done"
                           VerticalOptions="Center"
                           TextChanged="OnRecipientTextChanged"
                           Completed="OnRecipientCompleted" />
                    <Image x:Name="ClearButton"
                           Grid.Column="2"
                           IsVisible="False"
                           Source="close.png"
                           WidthRequest="16"
                           HeightRequest="16"
                           VerticalOptions="Center"
                           SemanticProperties.Description="{loc:Translate Chat_Cancel}">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnClearTapped" />
                        </Image.GestureRecognizers>
                        <Image.Behaviors>
                            <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#59615A, Dark=#9AA0AB}" />
                        </Image.Behaviors>
                    </Image>
                    <Border x:Name="SimChip"
                            Grid.Column="3"
                            IsVisible="False"
                            Padding="10,4"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{AppThemeBinding Light=#E3EAE2, Dark=#2A302C}"
                            VerticalOptions="Center"
                            SemanticProperties.Description="{loc:Translate Compose_Sim}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSimChipTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="5">
                            <Image Source="sim_card.png"
                                   WidthRequest="13"
                                   HeightRequest="13"
                                   VerticalOptions="Center">
                                <Image.Behaviors>
                                    <behaviors:IconTintBehavior TintColor="{StaticResource Primary}" />
                                </Image.Behaviors>
                            </Image>
                            <Label x:Name="SimLabel"
                                   FontSize="11"
                                   FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                                   TextColor="{AppThemeBinding Light=#59615A, Dark=#C9CFCB}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Contacts -->
        <Grid Grid.Row="2">
            <CollectionView x:Name="ContactList"
                            Margin="0,0,22,0"
                            ItemTemplate="{StaticResource RowSelector}"
                            SelectionMode="None"
                            VerticalScrollBarVisibility="Never" />

            <Label x:Name="EmptyLabel"
                   IsVisible="False"
                   Margin="32,0"
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#59615A, Dark=#9AA0AB}" />

            <!-- Alphabet fast scroll -->
            <VerticalStackLayout x:Name="LetterStrip"
                                 WidthRequest="22"
                                 Margin="0,8,2,8"
                                 Spacing="1"
                                 HorizontalOptions="End"
                                 VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentView>
