<?xml version="1.0" encoding="utf-8" ?>
<settings:SettingsScreen xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         xmlns:loc="clr-namespace:Gheychi.App.Localization"
                         xmlns:vm="clr-namespace:Gheychi.App.ViewModels"
                         xmlns:behaviors="clr-namespace:Gheychi.App.Behaviors"
                         xmlns:settings="clr-namespace:Gheychi.App.Controls.Settings"
                         x:Class="Gheychi.App.Controls.Settings.TrustedSendersScreen">
    <settings:SettingsScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <settings:SettingsStyles />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </settings:SettingsScreen.Resources>

    <Grid Style="{StaticResource ScreenBackground}" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Padding="12,0,16,0" HeightRequest="56" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Border Style="{StaticResource BackButton}" SemanticProperties.Description="{loc:Translate Chat_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Image Source="back.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.Behaviors>
                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#2C342E, Dark=#E8EAED}" />
                    </Image.Behaviors>
                </Image>
            </Border>
            <Label Grid.Column="1" Text="{loc:Translate Settings_Trusted}" Style="{StaticResource ScreenTitle}" />
        </Grid>

        <CollectionView x:Name="TrustedList"
                        Grid.Row="1"
                        Margin="8,0"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.EmptyView>
                <Label Text="{loc:Translate Settings_TrustedEmpty}"
                       Margin="24,48,24,0"
                       Style="{StaticResource Note}"
                       HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:TrustedSenderRow">
                    <Grid Padding="10,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Style="{StaticResource Badge}">
                            <Image Source="person.png" Style="{StaticResource BadgeIcon}">
                                <Image.Behaviors>
                                    <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#33443C, Dark=#D9E3DD}" />
                                </Image.Behaviors>
                            </Image>
                        </Border>
                        <Label Grid.Column="1" Text="{Binding Display}" Style="{StaticResource RowTitle}" VerticalOptions="Center" />
                        <Border Grid.Column="2"
                                WidthRequest="36"
                                HeightRequest="36"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"
                                SemanticProperties.Description="{loc:Translate Settings_TrustedRemove}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRemoveTapped" />
                            </Border.GestureRecognizers>
                            <Image Source="close.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image.Behaviors>
                                    <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#59615A, Dark=#9AA0AB}" />
                                </Image.Behaviors>
                            </Image>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</settings:SettingsScreen>
