<?xml version="1.0" encoding="utf-8" ?>
<settings:SettingsScreen xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         xmlns:loc="clr-namespace:Gheychi.App.Localization"
                         xmlns:vm="clr-namespace:Gheychi.App.ViewModels"
                         xmlns:behaviors="clr-namespace:Gheychi.App.Behaviors"
                         xmlns:settings="clr-namespace:Gheychi.App.Controls.Settings"
                         x:Class="Gheychi.App.Controls.Settings.SimSettingsScreen">
    <settings:SettingsScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <settings:SettingsStyles />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </settings:SettingsScreen.Resources>

    <Grid Style="{StaticResource ScreenBackground}" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Padding="12,0,16,0" HeightRequest="56" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Border Style="{StaticResource BackButton}" SemanticProperties.Description="{loc:Translate Chat_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Image Source="back.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.Behaviors>
                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#2C342E, Dark=#E8EAED}" />
                    </Image.Behaviors>
                </Image>
            </Border>
            <Label Grid.Column="1" Text="{loc:Translate Settings_Sims}" Style="{StaticResource ScreenTitle}" />
        </Grid>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="0,0,0,24">
                <Label Text="{loc:Translate Settings_SectionSims}" Style="{StaticResource SectionTitle}" Margin="26,4,16,8" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout x:Name="SimList">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SimSettingsRow">
                                <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*">
                                    <Border Style="{StaticResource Badge}" BackgroundColor="{AppThemeBinding Light=#D7EEDF, Dark=#1F4A35}">
                                        <Image Source="sim_card.png" Style="{StaticResource BadgeIcon}">
                                            <Image.Behaviors>
                                                <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#1B5E43, Dark=#8FE0BE}" />
                                            </Image.Behaviors>
                                        </Image>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                                        <Label Text="{Binding Subtitle}" Style="{StaticResource RowSubtitle}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{loc:Translate Settings_SectionSending}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDefaultSimTapped" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="{loc:Translate Settings_DefaultSim}" Style="{StaticResource RowTitle}" />
                            <Label Text="{loc:Translate Settings_DefaultSimHint}" Style="{StaticResource RowSubtitle}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Style="{StaticResource ValueChip}">
                            <HorizontalStackLayout Spacing="6">
                                <Label x:Name="DefaultSimValue" Style="{StaticResource ValueChipLabel}" />
                                <Image Source="unfold.png" WidthRequest="15" HeightRequest="15" VerticalOptions="Center">
                                    <Image.Behaviors>
                                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#59615A, Dark=#9AA0AB}" />
                                    </Image.Behaviors>
                                </Image>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</settings:SettingsScreen>
