<settings:SettingsScreen xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:app="clr-namespace:Gheychi.App"
                         xmlns:loc="clr-namespace:Gheychi.App.Localization"
                         xmlns:vm="clr-namespace:Gheychi.App.ViewModels"
                         xmlns:theme="clr-namespace:Gheychi.App.Theming"
                         xmlns:ui="clr-namespace:Gheychi.App.Ui"
                         xmlns:settings="clr-namespace:Gheychi.App.Controls.Settings"
                         x:Class="Gheychi.App.Controls.Settings.BlockedSendersScreen">
    <Grid Classes="screen" RowDefinitions="Auto,Auto,*">
        <settings:SettingsHeader Title="{loc:Translate Settings_Blocked}" />

        <TextBlock Grid.Row="1" Text="{loc:Translate Settings_BlockedNote}" Classes="note" Margin="26,0,26,12" />

        <Border Grid.Row="2"
                CornerRadius="28,28,0,0"
                ClipToBounds="True"
                Background="{theme:ThemeBrush Light=#FFFFFF, Dark=#1E1F22}">
        <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Hidden">
            <ItemsControl x:Name="BlockedList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BlockedSenderRow">
                        <Grid MinHeight="68" Margin="16,6,10,6" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Width="44" Height="44" CornerRadius="22" VerticalAlignment="Center"
                                    Background="{theme:ThemeBrush Light=#F7E3E1, Dark=#3A2224}">
                                <Panel>
                                    <ui:Icon IsVisible="{Binding HasNoInitials}" Data="{StaticResource Icon.Person}"
                                             Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Foreground="{theme:ThemeBrush Light=#B3261E, Dark=#F2B8B5}" />
                                    <TextBlock Text="{Binding Initials}" FontSize="19"
                                               FontFamily="{x:Static app:AppFonts.Bold}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{theme:ThemeBrush Light=#B3261E, Dark=#F2B8B5}" />
                                </Panel>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Classes="rowTitle" />
                                <TextBlock Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" Classes="rowSubtitle" />
                            </StackPanel>
                            <Border Grid.Column="2" Width="36" Height="36" CornerRadius="18" Background="Transparent"
                                    VerticalAlignment="Center" Tapped="OnUnblockTapped"
                                    AutomationProperties.Name="{loc:Translate Settings_BlockedUnblock}">
                                <ui:Icon Data="{StaticResource Icon.Close}" Width="16" Height="16"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Foreground="{theme:ThemeBrush Light=#595C61, Dark=#9AA0AB}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        </Border>

        <TextBlock x:Name="EmptyNote" Grid.Row="2" Text="{loc:Translate Settings_BlockedEmpty}" Margin="24,48,24,0"
                   Classes="note" TextAlignment="Center" VerticalAlignment="Top" IsVisible="False" />
    </Grid>
</settings:SettingsScreen>
