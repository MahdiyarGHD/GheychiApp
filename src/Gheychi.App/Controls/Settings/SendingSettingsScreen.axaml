<settings:SettingsScreen xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:loc="clr-namespace:Gheychi.App.Localization"
                         xmlns:theme="clr-namespace:Gheychi.App.Theming"
                         xmlns:ui="clr-namespace:Gheychi.App.Ui"
                         xmlns:settings="clr-namespace:Gheychi.App.Controls.Settings"
                         x:Class="Gheychi.App.Controls.Settings.SendingSettingsScreen">
    <Grid Classes="screen" RowDefinitions="Auto,*">
        <settings:SettingsHeader Title="{loc:Translate Settings_Sending}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="0,4,0,24">
                <Border Classes="card">
                    <StackPanel>
                        <Border Classes="row" Tapped="OnSendDelayTapped">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Border Classes="badge" Background="{theme:AccentBrush Role=Soft}">
                                    <ui:Icon Classes="badgeIcon" Data="{StaticResource Icon.Snooze}"
                                             Foreground="{theme:AccentBrush Role=Text}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Translate Settings_SendDelay}" Classes="rowTitle" />
                                    <TextBlock Text="{loc:Translate Settings_SendDelayHint}" Classes="rowSubtitle" />
                                </StackPanel>
                                <Border Grid.Column="2" Classes="valueChip">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="SendDelayValue" Classes="valueChipLabel" />
                                        <ui:Icon Classes="unfold" Data="{StaticResource Icon.Unfold}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel x:Name="ExactRow">
                            <Border Classes="divider" />
                            <Border Classes="row" Tapped="OnExactAlarmsTapped">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Classes="badge">
                                        <ui:Icon Classes="badgeIcon" Data="{StaticResource Icon.Notifications}"
                                                 Foreground="{theme:ThemeBrush Light=#393B3E, Dark=#DDDEDF}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Translate Settings_ExactAlarms}" Classes="rowTitle" />
                                        <TextBlock x:Name="ExactHint" Classes="rowSubtitle" />
                                    </StackPanel>
                                    <ui:Icon Grid.Column="2" Classes="chevron" Data="{StaticResource Icon.ChevronRight}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card" Margin="16,12,16,0">
                    <Border Classes="row">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Classes="badge">
                                <ui:Icon Classes="badgeIcon" Data="{StaticResource Icon.Chat}"
                                         Foreground="{theme:ThemeBrush Light=#393B3E, Dark=#DDDEDF}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Translate Settings_CharCounter}" Classes="rowTitle" />
                                <TextBlock Text="{loc:Translate Settings_CharCounterHint}" Classes="rowSubtitle" />
                            </StackPanel>
                            <ToggleButton x:Name="CharCounterSwitch" Grid.Column="2" Classes="setting"
                                          IsCheckedChanged="OnCharCounterToggled" />
                        </Grid>
                    </Border>
                </Border>

                <Border Classes="card" Margin="16,12,16,0">
                    <Border Classes="row">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Classes="badge" Background="{theme:AccentBrush Role=Soft}">
                                <ui:Icon Classes="badgeIcon" Data="{StaticResource Icon.Info}"
                                         Foreground="{theme:AccentBrush Role=Text}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{loc:Translate Settings_ScheduleHint}" Classes="rowSubtitle"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</settings:SettingsScreen>
