<?xml version="1.0" encoding="utf-8" ?>
<settings:SettingsScreen xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         xmlns:loc="clr-namespace:Gheychi.App.Localization"
                         xmlns:vm="clr-namespace:Gheychi.App.ViewModels"
                         xmlns:behaviors="clr-namespace:Gheychi.App.Behaviors"
                         xmlns:settings="clr-namespace:Gheychi.App.Controls.Settings"
                         x:Class="Gheychi.App.Controls.Settings.SpamAnalyticsScreen">
    <settings:SettingsScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <settings:SettingsStyles />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </settings:SettingsScreen.Resources>

    <Grid Style="{StaticResource ScreenBackground}" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Padding="12,0,16,0" HeightRequest="56" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Border Style="{StaticResource BackButton}" SemanticProperties.Description="{loc:Translate Chat_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Image Source="back.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.Behaviors>
                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#2C342E, Dark=#E8EAED}" />
                    </Image.Behaviors>
                </Image>
            </Border>
            <Label Grid.Column="1" Text="{loc:Translate Settings_Analytics}" Style="{StaticResource ScreenTitle}" />
        </Grid>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="0,4,0,24">
                <Grid Margin="16,0" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource Tile}">
                        <VerticalStackLayout Spacing="2">
                            <Label x:Name="TotalValue" Style="{StaticResource BigNumber}" />
                            <Label x:Name="TotalCaption" Style="{StaticResource TileCaption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource Tile}">
                        <VerticalStackLayout Spacing="2">
                            <Label x:Name="TodayValue" Style="{StaticResource BigNumber}" />
                            <Label Text="{loc:Translate Settings_StatToday}" Style="{StaticResource TileCaption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource Tile}">
                        <VerticalStackLayout Spacing="2">
                            <Label x:Name="WeekValue" Style="{StaticResource BigNumber}" />
                            <Label Text="{loc:Translate Settings_StatWeek}" Style="{StaticResource TileCaption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource Tile}">
                        <VerticalStackLayout Spacing="2">
                            <Label x:Name="MonthValue" Style="{StaticResource BigNumber}" />
                            <Label Text="{loc:Translate Settings_StatMonth}" Style="{StaticResource TileCaption}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label x:Name="EmptyNote"
                       Text="{loc:Translate Settings_AnalyticsEmpty}"
                       Margin="26,20,26,0"
                       Style="{StaticResource Note}"
                       HorizontalTextAlignment="Center"
                       IsVisible="False" />

                <VerticalStackLayout x:Name="Details">
                    <Label Text="{loc:Translate Settings_SectionDaily}" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}" Padding="14,16,14,10">
                        <Grid x:Name="DailyChart" HeightRequest="118" ColumnSpacing="4" />
                    </Border>

                    <Label Text="{loc:Translate Settings_SectionConfidence}" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <VerticalStackLayout Spacing="10">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 5" HeightRequest="10">
                                <Grid x:Name="ConfidenceBar">
                                    <BoxView x:Name="VeryLikelyBar" Grid.Column="0" Color="#D64545" />
                                    <BoxView x:Name="LikelyBar" Grid.Column="1" Color="#C7841A" />
                                </Grid>
                            </Border>
                            <Grid ColumnDefinitions="*,*">
                                <HorizontalStackLayout Spacing="6">
                                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#D64545" VerticalOptions="Center" />
                                    <Label x:Name="VeryLikelyLegend" Style="{StaticResource Note}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#C7841A" VerticalOptions="Center" />
                                    <Label x:Name="LikelyLegend" Style="{StaticResource Note}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{loc:Translate Settings_SectionAccuracy}" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*">
                            <Border Style="{StaticResource Badge}" BackgroundColor="{AppThemeBinding Light=#D7EEDF, Dark=#1F4A35}">
                                <Image Source="shield.png" Style="{StaticResource BadgeIcon}">
                                    <Image.Behaviors>
                                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#1B5E43, Dark=#8FE0BE}" />
                                    </Image.Behaviors>
                                </Image>
                            </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label x:Name="AccuracyValue" Style="{StaticResource RowTitle}" />
                                    <Label x:Name="AccuracyHint" Style="{StaticResource RowSubtitle}" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*">
                            <Border Style="{StaticResource Badge}">
                                <Image Source="history.png" Style="{StaticResource BadgeIcon}">
                                    <Image.Behaviors>
                                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#33443C, Dark=#D9E3DD}" />
                                    </Image.Behaviors>
                                </Image>
                            </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label x:Name="BusiestValue" Style="{StaticResource RowTitle}" />
                                    <Label Text="{loc:Translate Settings_BusiestHint}" Style="{StaticResource RowSubtitle}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout x:Name="TopSendersSection">
                        <Label Text="{loc:Translate Settings_SectionTopSenders}" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout x:Name="TopSenderList">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TopSenderRow">
                                        <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*,Auto">
                                        <Border Style="{StaticResource Badge}">
                                            <Image Source="spamrow.png" Style="{StaticResource BadgeIcon}">
                                                <Image.Behaviors>
                                                    <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#33443C, Dark=#D9E3DD}" />
                                                </Image.Behaviors>
                                            </Image>
                                        </Border>
                                            <Label Grid.Column="1" Text="{Binding Display}" Style="{StaticResource RowTitle}" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding Count}" Style="{StaticResource ValueChipLabel}" FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</settings:SettingsScreen>
