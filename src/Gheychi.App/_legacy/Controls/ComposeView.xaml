<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Gheychi.App.ViewModels"
             xmlns:loc="clr-namespace:Gheychi.App.Localization"
             xmlns:behaviors="clr-namespace:Gheychi.App.Behaviors"
             x:Class="Gheychi.App.Controls.ComposeView"
             behaviors:TouchShield.IsEnabled="True"
             BackgroundColor="{AppThemeBinding Light=#F7FAF4, Dark=#121413}">

    <ContentView.Resources>
        <!-- Section title: a letter or "Recent" -->
        <DataTemplate x:Key="HeaderTemplate" x:DataType="vm:ComposeRow">
            <Label Text="{Binding Letter}"
                   Padding="20,10,16,2"
                   FontSize="11"
                   CharacterSpacing="0.8"
                   FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                   TextColor="{AppThemeBinding Light=#2E6B4C, Dark=#8FE0BE}" />
        </DataTemplate>

        <!-- A person: avatar, name, "Mobile · number" -->
        <DataTemplate x:Key="ContactTemplate" x:DataType="vm:ComposeRow">
            <Grid Padding="16,5"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="12"
                  BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRowTapped" />
                </Grid.GestureRecognizers>
                <Border Grid.Column="0"
                        WidthRequest="40"
                        HeightRequest="40"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light=#E3E9E4, Dark=#35423C}"
                        InputTransparent="True">
                    <Grid InputTransparent="True" CascadeInputTransparent="True">
                        <Label Text="{Binding Initials}"
                               IsVisible="{Binding HasInitials}"
                               FontSize="13"
                               FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                               TextColor="{AppThemeBinding Light=#1B5E43, Dark=#8FE0BE}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <Image Source="person.png"
                               IsVisible="{Binding HasNoInitials}"
                               WidthRequest="18"
                               HeightRequest="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                            <Image.Behaviors>
                                <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#1B5E43, Dark=#8FE0BE}" />
                            </Image.Behaviors>
                        </Image>
                    </Grid>
                </Border>
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="1"
                                     VerticalOptions="Center"
                                     InputTransparent="True"
                                     CascadeInputTransparent="True">
                    <Label Text="{Binding Name}"
                           FontSize="14"
                           FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           TextColor="{AppThemeBinding Light=#1A1C19, Dark=#E8EAED}" />
                    <Label Text="{Binding Subtitle}"
                           IsVisible="{Binding HasSubtitle}"
                           FontSize="12"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           TextColor="{AppThemeBinding Light=#646C65, Dark=#9AA0AB}" />
                </VerticalStackLayout>
            </Grid>
        </DataTemplate>

        <!-- "Send to 0903…": the number typed in the To field -->
        <DataTemplate x:Key="TypedTemplate" x:DataType="vm:ComposeRow">
            <Grid Padding="16,5"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="12"
                  BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRowTapped" />
                </Grid.GestureRecognizers>
                <Border Grid.Column="0"
                        WidthRequest="40"
                        HeightRequest="40"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource Primary}"
                        InputTransparent="True">
                    <Image Source="send.png"
                           WidthRequest="18"
                           HeightRequest="18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           InputTransparent="True">
                        <Image.Behaviors>
                            <behaviors:IconTintBehavior TintColor="White" />
                        </Image.Behaviors>
                    </Image>
                </Border>
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="1"
                                     VerticalOptions="Center"
                                     InputTransparent="True"
                                     CascadeInputTransparent="True">
                    <Label Text="{Binding Name}"
                           FontSize="14"
                           FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           TextColor="{AppThemeBinding Light=#1A1C19, Dark=#E8EAED}" />
                    <Label Text="{Binding Subtitle}"
                           FontSize="12"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           TextColor="{AppThemeBinding Light=#2E6B4C, Dark=#8FE0BE}" />
                </VerticalStackLayout>
            </Grid>
        </DataTemplate>

        <vm:ComposeRowTemplateSelector x:Key="RowSelector"
                                       HeaderTemplate="{StaticResource HeaderTemplate}"
                                       ContactTemplate="{StaticResource ContactTemplate}"
                                       TypedTemplate="{StaticResource TypedTemplate}" />
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">

        <!-- Header -->
        <Grid Grid.Row="0"
              HeightRequest="48"
              Padding="8,0,12,0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="4">
            <Border Grid.Column="0"
                    WidthRequest="40"
                    HeightRequest="40"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="Transparent"
                    VerticalOptions="Center"
                    SemanticProperties.Description="{loc:Translate Chat_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Image Source="back.png"
                       WidthRequest="20"
                       HeightRequest="20"
                       HorizontalOptions="Center"
                       VerticalOptions="Center">
                    <Image.Behaviors>
                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#2C342E, Dark=#E8EAED}" />
                    </Image.Behaviors>
                </Image>
            </Border>
            <Label Grid.Column="1"
                   Text="{loc:Translate Compose_Title}"
                   FontSize="18"
                   FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                   TextColor="{AppThemeBinding Light=#1A1C19, Dark=#E8EAED}"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Recipient field -->
        <Border x:Name="RecipientCard"
                Grid.Row="1"
                Margin="12,0,12,6"
                Padding="14,0,6,0"
                HeightRequest="42"
                StrokeThickness="1.5"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 21"
                BackgroundColor="{AppThemeBinding Light=#EAF0E8, Dark=#1E2320}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                <Label Grid.Column="0"
                       Text="{loc:Translate Compose_To}"
                       FontSize="13"
                       FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                       TextColor="{AppThemeBinding Light=#2E6B4C, Dark=#8FE0BE}"
                       VerticalOptions="Center" />
                <Entry x:Name="RecipientEntry"
                       Grid.Column="1"
                       Placeholder="{loc:Translate Compose_Hint}"
                       PlaceholderColor="{AppThemeBinding Light=#7C857D, Dark=#7F8791}"
                       TextColor="{AppThemeBinding Light=#1A1C19, Dark=#E8EAED}"
                       BackgroundColor="Transparent"
                       FontSize="14"
                       FontFamily="{x:Static vm:ThreadItem.FontFamilyRegular}"
                       ClearButtonVisibility="Never"
                       ReturnType="Go"
                       VerticalOptions="Center"
                       TextChanged="OnRecipientTextChanged"
                       Completed="OnRecipientCompleted"
                       Focused="OnRecipientFocusChanged"
                       Unfocused="OnRecipientFocusChanged" />
                <Border x:Name="ClearButton"
                        Grid.Column="2"
                        IsVisible="False"
                        WidthRequest="30"
                        HeightRequest="30"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 15"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"
                        SemanticProperties.Description="{loc:Translate Chat_Cancel}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnClearTapped" />
                    </Border.GestureRecognizers>
                    <Image Source="close.png"
                           WidthRequest="14"
                           HeightRequest="14"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           InputTransparent="True">
                        <Image.Behaviors>
                            <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#59615A, Dark=#9AA0AB}" />
                        </Image.Behaviors>
                    </Image>
                </Border>
                <Border x:Name="SimChip"
                        Grid.Column="3"
                        IsVisible="False"
                        Padding="9,0"
                        HeightRequest="28"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{AppThemeBinding Light=#D9E4D7, Dark=#2A332D}"
                        VerticalOptions="Center"
                        SemanticProperties.Description="{loc:Translate Compose_Sim}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSimChipTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Image Source="sim_card.png"
                               WidthRequest="13"
                               HeightRequest="13"
                               VerticalOptions="Center">
                            <Image.Behaviors>
                                <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#2E6B4C, Dark=#8FE0BE}" />
                            </Image.Behaviors>
                        </Image>
                        <Label x:Name="SimLabel"
                               FontSize="11"
                               FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                               TextColor="{AppThemeBinding Light=#34443A, Dark=#CFE5D8}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

        <!-- Suggestions and contacts -->
        <Grid Grid.Row="2">
            <CollectionView x:Name="ContactList"
                            ItemTemplate="{StaticResource RowSelector}"
                            SelectionMode="None"
                            VerticalScrollBarVisibility="Never">
                <CollectionView.Footer>
                    <Grid HeightRequest="24" />
                </CollectionView.Footer>
            </CollectionView>

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               Margin="0,56,0,0"
                               VerticalOptions="Start"
                               HorizontalOptions="Center" />

            <VerticalStackLayout x:Name="EmptyState"
                                 IsVisible="False"
                                 Spacing="8"
                                 Margin="36,48,36,0"
                                 VerticalOptions="Start"
                                 HorizontalOptions="Center">
                <Border WidthRequest="64"
                        HeightRequest="64"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 32"
                        BackgroundColor="{AppThemeBinding Light=#E3E9E4, Dark=#1E2320}"
                        HorizontalOptions="Center">
                    <Image Source="person.png"
                           WidthRequest="26"
                           HeightRequest="26"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <Image.Behaviors>
                            <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#2E6B4C, Dark=#8FE0BE}" />
                        </Image.Behaviors>
                    </Image>
                </Border>
                <Label x:Name="EmptyTitle"
                       FontSize="16"
                       FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#1A1C19, Dark=#E8EAED}" />
                <Label x:Name="EmptyHint"
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#646C65, Dark=#9AA0AB}" />
                <Border x:Name="EmptyAction"
                        IsVisible="False"
                        Margin="0,10,0,0"
                        Padding="22,11"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        BackgroundColor="{StaticResource Primary}"
                        HorizontalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEmptyActionTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="{loc:Translate Compose_OpenSettings}"
                           FontSize="14"
                           FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                           TextColor="White"
                           InputTransparent="True" />
                </Border>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentView>
