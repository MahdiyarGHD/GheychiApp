<?xml version="1.0" encoding="utf-8" ?>
<settings:SettingsScreen xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         xmlns:loc="clr-namespace:Gheychi.App.Localization"
                         xmlns:vm="clr-namespace:Gheychi.App.ViewModels"
                         xmlns:behaviors="clr-namespace:Gheychi.App.Behaviors"
                         xmlns:settings="clr-namespace:Gheychi.App.Controls.Settings"
                         x:Class="Gheychi.App.Controls.Settings.SpamSettingsScreen">
    <settings:SettingsScreen.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <settings:SettingsStyles />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </settings:SettingsScreen.Resources>

    <Grid Style="{StaticResource ScreenBackground}" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Padding="12,0,16,0" HeightRequest="56" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Border Style="{StaticResource BackButton}" SemanticProperties.Description="{loc:Translate Chat_Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Image Source="back.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.Behaviors>
                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#2C342E, Dark=#E8EAED}" />
                    </Image.Behaviors>
                </Image>
            </Border>
            <Label Grid.Column="1" Text="{loc:Translate Settings_Spam}" Style="{StaticResource ScreenTitle}" />
        </Grid>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="0,4,0,24">
                <Border Style="{StaticResource Card}">
                    <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*,Auto">
                        <Border Style="{StaticResource Badge}" BackgroundColor="{AppThemeBinding Light=#F5E4DA, Dark=#3A2A22}">
                            <Image Source="tabspam.png" Style="{StaticResource BadgeIcon}">
                                <Image.Behaviors>
                                    <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#9A4A2A, Dark=#F0B79A}" />
                                </Image.Behaviors>
                            </Image>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="{loc:Translate Settings_SpamFilter}" Style="{StaticResource RowTitle}" />
                            <Label x:Name="FilterHint" Style="{StaticResource RowSubtitle}" />
                        </VerticalStackLayout>
                        <Switch x:Name="FilterSwitch" Grid.Column="2" Style="{StaticResource SettingSwitch}" Toggled="OnFilterToggled" />
                    </Grid>
                </Border>

                <VerticalStackLayout x:Name="FilterOptions">
                    <Label Text="{loc:Translate Settings_SectionSensitivity}" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}" Padding="14">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Border x:Name="PresetRelaxed" Grid.Column="0" Style="{StaticResource SegmentOff}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPresetTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="{loc:Translate Settings_Relaxed}" Style="{StaticResource SegmentTitleOff}" />
                                        <Label Style="{StaticResource SegmentHintOff}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border x:Name="PresetBalanced" Grid.Column="1" Style="{StaticResource SegmentOff}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPresetTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="{loc:Translate Settings_Balanced}" Style="{StaticResource SegmentTitleOff}" />
                                        <Label Style="{StaticResource SegmentHintOff}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border x:Name="PresetStrict" Grid.Column="2" Style="{StaticResource SegmentOff}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPresetTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="{loc:Translate Settings_Strict}" Style="{StaticResource SegmentTitleOff}" />
                                        <Label Style="{StaticResource SegmentHintOff}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" Padding="2,0">
                                <Label Text="{loc:Translate Settings_Threshold}"
                                       FontSize="14"
                                       FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                                       TextColor="{AppThemeBinding Light=#1B1E24, Dark=#E8EAED}"
                                       VerticalOptions="Center" />
                                <Label x:Name="SensitivityValue"
                                       Grid.Column="1"
                                       FontSize="14"
                                       FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                                       TextColor="{AppThemeBinding Light=#1B5E43, Dark=#8FE0BE}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <!-- Maximum before Minimum: a minimum above the default maximum of 1 throws -->
                            <Slider x:Name="SensitivitySlider"
                                    Maximum="99"
                                    Minimum="50"
                                    Margin="-6,-6"
                                    MinimumTrackColor="#2E6B4C"
                                    ThumbColor="#2E6B4C"
                                    ValueChanged="OnSensitivityChanged" />
                            <Label x:Name="SensitivityExplain" Style="{StaticResource Note}" Margin="2,0" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{loc:Translate Settings_SectionDigest}" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*,Auto">
                                <Border Style="{StaticResource Badge}">
                                    <Image Source="notifications.png" Style="{StaticResource BadgeIcon}">
                                        <Image.Behaviors>
                                            <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#33443C, Dark=#D9E3DD}" />
                                        </Image.Behaviors>
                                    </Image>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{loc:Translate Settings_Digest}" Style="{StaticResource RowTitle}" />
                                    <Label Text="{loc:Translate Settings_DigestHint}" Style="{StaticResource RowSubtitle}" />
                                </VerticalStackLayout>
                                <Switch x:Name="DigestSwitch" Grid.Column="2" Style="{StaticResource SettingSwitch}" Toggled="OnDigestToggled" />
                            </Grid>
                            <BoxView Style="{StaticResource Divider}" />
                            <Grid x:Name="DigestTimeRow" Style="{StaticResource Row}" ColumnDefinitions="Auto,*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDigestTimeTapped" />
                                </Grid.GestureRecognizers>
                                <Border Style="{StaticResource Badge}">
                                    <Image Source="history.png" Style="{StaticResource BadgeIcon}">
                                        <Image.Behaviors>
                                            <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#33443C, Dark=#D9E3DD}" />
                                        </Image.Behaviors>
                                    </Image>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{loc:Translate Settings_DigestTime}" Style="{StaticResource RowTitle}" />
                                    <Label Text="{loc:Translate Settings_DigestTimeHint}" Style="{StaticResource RowSubtitle}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" Style="{StaticResource ValueChip}">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label x:Name="DigestTimeValue" Style="{StaticResource ValueChipLabel}" />
                                        <Image Source="unfold.png" WidthRequest="15" HeightRequest="15" VerticalOptions="Center">
                                            <Image.Behaviors>
                                                <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#59615A, Dark=#9AA0AB}" />
                                            </Image.Behaviors>
                                        </Image>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Label Text="{loc:Translate Settings_SectionSpamList}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAutoClearTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource Badge}">
                                <Image Source="history.png" Style="{StaticResource BadgeIcon}">
                                    <Image.Behaviors>
                                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#33443C, Dark=#D9E3DD}" />
                                    </Image.Behaviors>
                                </Image>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{loc:Translate Settings_AutoClear}" Style="{StaticResource RowTitle}" />
                                <Label Text="{loc:Translate Settings_AutoClearHint}" Style="{StaticResource RowSubtitle}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" Style="{StaticResource ValueChip}">
                                <HorizontalStackLayout Spacing="6">
                                    <Label x:Name="AutoClearValue" Style="{StaticResource ValueChipLabel}" />
                                    <Image Source="unfold.png" WidthRequest="15" HeightRequest="15" VerticalOptions="Center">
                                        <Image.Behaviors>
                                            <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#59615A, Dark=#9AA0AB}" />
                                        </Image.Behaviors>
                                    </Image>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTrustedTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource Badge}">
                                <Image Source="person.png" Style="{StaticResource BadgeIcon}">
                                    <Image.Behaviors>
                                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#33443C, Dark=#D9E3DD}" />
                                    </Image.Behaviors>
                                </Image>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{loc:Translate Settings_Trusted}" Style="{StaticResource RowTitle}" />
                                <Label x:Name="TrustedHint" Style="{StaticResource RowSubtitle}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Style="{StaticResource Chevron}">
                                <Image.Behaviors>
                                    <behaviors:IconTintBehavior TintColor="#8A8F98" />
                                </Image.Behaviors>
                            </Image>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAnalyticsTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource Badge}">
                                <Image Source="chart.png" Style="{StaticResource BadgeIcon}">
                                    <Image.Behaviors>
                                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#33443C, Dark=#D9E3DD}" />
                                    </Image.Behaviors>
                                </Image>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{loc:Translate Settings_Analytics}" Style="{StaticResource RowTitle}" />
                                <Label Text="{loc:Translate Settings_AnalyticsHint}" Style="{StaticResource RowSubtitle}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Style="{StaticResource Chevron}">
                                <Image.Behaviors>
                                    <behaviors:IconTintBehavior TintColor="#8A8F98" />
                                </Image.Behaviors>
                            </Image>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{loc:Translate Settings_SectionModel}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*">
                            <Border Style="{StaticResource Badge}" BackgroundColor="{AppThemeBinding Light=#D7EEDF, Dark=#1F4A35}">
                                <Image Source="shield.png" Style="{StaticResource BadgeIcon}">
                                    <Image.Behaviors>
                                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#1B5E43, Dark=#8FE0BE}" />
                                    </Image.Behaviors>
                                </Image>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label x:Name="ModelVersion" Style="{StaticResource RowTitle}" />
                                <Label Text="{loc:Translate Settings_ModelHint}" Style="{StaticResource RowSubtitle}" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnModelUpdateTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource Badge}">
                                <Image Source="download.png" Style="{StaticResource BadgeIcon}">
                                    <Image.Behaviors>
                                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#33443C, Dark=#D9E3DD}" />
                                    </Image.Behaviors>
                                </Image>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label x:Name="ModelUpdateTitle" Style="{StaticResource RowTitle}" />
                                <Label x:Name="ModelUpdateHint" Style="{StaticResource RowSubtitle}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Style="{StaticResource Chevron}">
                                <Image.Behaviors>
                                    <behaviors:IconTintBehavior TintColor="#8A8F98" />
                                </Image.Behaviors>
                            </Image>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</settings:SettingsScreen>
