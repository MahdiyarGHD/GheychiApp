<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Gheychi.App.Localization"
             xmlns:vm="clr-namespace:Gheychi.App.ViewModels"
             xmlns:controls="clr-namespace:Gheychi.App.Controls"
             xmlns:behaviors="clr-namespace:Gheychi.App.Behaviors"
             x:Class="Gheychi.App.Pages.SpamPage"
             x:DataType="vm:SpamViewModel"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- App header -->
        <Grid x:Name="AppHeader" Grid.Row="0" Padding="18,8,6,8" ColumnDefinitions="*,Auto,Auto">
            <Label Grid.Column="0"
                   Text="Gheychi"
                   FontSize="19"
                   FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                   TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                   VerticalOptions="Center" />
            <Border Grid.Column="1"
                    WidthRequest="40"
                    HeightRequest="40"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="Transparent"
                    VerticalOptions="Center"
                    SemanticProperties.Description="{loc:Translate Tab_Settings}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSettingsTapped" />
                </Border.GestureRecognizers>
                <Image Source="tabsettings.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.Behaviors>
                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#2C342E, Dark=#E8EAED}" />
                    </Image.Behaviors>
                </Image>
            </Border>
            <Border Grid.Column="2"
                    WidthRequest="40"
                    HeightRequest="40"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="Transparent"
                    VerticalOptions="Center"
                    SemanticProperties.Description="{loc:Translate Spam_SearchHint}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSearchTapped" />
                </Border.GestureRecognizers>
                <Image Source="search.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.Behaviors>
                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#2C342E, Dark=#E8EAED}" />
                    </Image.Behaviors>
                </Image>
            </Border>
        </Grid>

        <!-- Search bar, in place of the header while searching -->
        <Border x:Name="SearchBar"
                Grid.Row="0"
                IsVisible="False"
                Margin="12,6"
                Padding="12,0,4,0"
                HeightRequest="42"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 21"
                BackgroundColor="{AppThemeBinding Light=#E8EDE6, Dark=#1C1F24}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Image Grid.Column="0" Source="search.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center">
                    <Image.Behaviors>
                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#59615A, Dark=#9AA0AB}" />
                    </Image.Behaviors>
                </Image>
                <Entry x:Name="SearchEntry"
                       Grid.Column="1"
                       Text="{Binding SearchText}"
                       Placeholder="{loc:Translate Spam_SearchHint}"
                       FontSize="14"
                       ReturnType="Search"
                       ClearButtonVisibility="Never"
                       VerticalOptions="Center" />
                <Border Grid.Column="2"
                        WidthRequest="34"
                        HeightRequest="34"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 17"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchCloseTapped" />
                    </Border.GestureRecognizers>
                    <Image Source="close.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image.Behaviors>
                            <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#59615A, Dark=#9AA0AB}" />
                        </Image.Behaviors>
                    </Image>
                </Border>
            </Grid>
        </Border>

        <BoxView Grid.Row="1" HeightRequest="1" Color="{AppThemeBinding Light=#E8EDE6, Dark=#2A302C}" />

        <!-- Title -->
        <Grid Grid.Row="2" Padding="18,16,10,8" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
            <Label Grid.Row="0"
                   Grid.Column="0"
                   Text="{loc:Translate Spam_PageTitle}"
                   FontSize="22"
                   FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                   TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                   LineBreakMode="TailTruncation"
                   MaxLines="1"
                   VerticalOptions="Center" />
            <Label Grid.Row="0"
                   Grid.Column="1"
                   Text="{loc:Translate Spam_ClearAll}"
                   IsVisible="{Binding HasAny}"
                   FontSize="13"
                   FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                   TextColor="{AppThemeBinding Light=#1B5E43, Dark=#8FE0BE}"
                   Padding="8,6"
                   VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnClearAllTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Text="{Binding Subtitle}"
                   FontSize="12"
                   TextColor="#8A8F98" />
        </Grid>

        <CollectionView x:Name="SpamList"
                        Grid.Row="3"
                        Margin="12,0,4,0"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="0,64,0,0" Spacing="10" HorizontalOptions="Center">
                    <Border WidthRequest="56"
                            HeightRequest="56"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 28"
                            BackgroundColor="{AppThemeBinding Light=#E7EEE6, Dark=#2A332D}"
                            HorizontalOptions="Center">
                        <Image Source="shield.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Behaviors>
                                <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#1B5E43, Dark=#8FE0BE}" />
                            </Image.Behaviors>
                        </Image>
                    </Border>
                    <Label Text="{loc:Translate Spam_Placeholder}"
                           FontSize="13"
                           TextColor="#8A8F98"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <vm:SpamTemplateSelector>
                    <vm:SpamTemplateSelector.DateSeparatorTemplate>
                        <DataTemplate x:DataType="vm:DateSeparatorItem">
                            <Label Text="{Binding Text}"
                                   Padding="6,14,0,4"
                                   FontSize="12"
                                   FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                                   TextColor="{AppThemeBinding Light=#1B5E43, Dark=#8FE0BE}" />
                        </DataTemplate>
                    </vm:SpamTemplateSelector.DateSeparatorTemplate>
                    <vm:SpamTemplateSelector.SpamTemplate>
                        <DataTemplate x:DataType="vm:SpamItem">
                            <Grid RowDefinitions="Auto,1">
                                <Grid Grid.Row="0"
                                      Padding="6,10,0,10"
                                      ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="12">
                                    <Border Grid.Column="0"
                                            WidthRequest="38"
                                            HeightRequest="38"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 19"
                                            BackgroundColor="{AppThemeBinding Light=#E7EEE6, Dark=#2A332D}"
                                            VerticalOptions="Start"
                                            Margin="0,2,0,0">
                                        <Image Source="spamrow.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Image.Behaviors>
                                                <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#33443C, Dark=#D9E3DD}" />
                                            </Image.Behaviors>
                                        </Image>
                                    </Border>

                                    <!-- The sender gives way first; the confidence and time are always shown whole -->
                                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                                        <Label Grid.Row="0"
                                               Grid.Column="0"
                                               Text="{Binding Sender}"
                                               FontSize="14"
                                               FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                                               TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"
                                               VerticalOptions="Center" />
                                        <Label Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{Binding Confidence}"
                                               FontSize="11"
                                               FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                                               TextColor="{Binding ConfidenceColor}"
                                               VerticalOptions="Center" />
                                        <Label Grid.Row="0"
                                               Grid.Column="2"
                                               Text="{Binding Clock}"
                                               FontSize="11"
                                               TextColor="#8A8F98"
                                               VerticalOptions="Center" />
                                        <Label Grid.Row="1"
                                               Grid.Column="0"
                                               Grid.ColumnSpan="3"
                                               Text="{Binding Preview}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light=#5E665F, Dark=#9AA0AB}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />
                                    </Grid>

                                    <Border Grid.Column="2"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 17"
                                            BackgroundColor="Transparent"
                                            VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMoreTapped" />
                                        </Border.GestureRecognizers>
                                        <Image Source="more.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Image.Behaviors>
                                                <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#8A8F98, Dark=#9AA0AB}" />
                                            </Image.Behaviors>
                                        </Image>
                                    </Border>
                                </Grid>
                                <BoxView Grid.Row="1" Margin="56,0,8,0" Color="{AppThemeBinding Light=#EEF1EC, Dark=#24292A}" />
                            </Grid>
                        </DataTemplate>
                    </vm:SpamTemplateSelector.SpamTemplate>
                </vm:SpamTemplateSelector>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <controls:SpamOverlay x:Name="Overlay" Grid.RowSpan="4" />
    </Grid>
</ContentPage>
