<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Gheychi.App.ViewModels"
             xmlns:loc="clr-namespace:Gheychi.App.Localization"
             xmlns:behaviors="clr-namespace:Gheychi.App.Behaviors"
             xmlns:controls="clr-namespace:Gheychi.App.Controls"
             x:Class="Gheychi.App.Pages.MessagesPage"
             Shell.NavBarIsVisible="False">

    <Grid x:Name="RootGrid">
        <Grid x:Name="InboxLayer" RowDefinitions="Auto,*">

        <!-- Top Header Area: Normal Search Header or Selection Contextual Header -->
        <Grid Grid.Row="0">
            <!-- Normal Header: same as the Spam tab's -->
            <VerticalStackLayout IsVisible="{Binding IsNotSelectionMode}">
                <Grid Padding="18,8,6,8" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Gheychi"
                           FontSize="19"
                           FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                           VerticalOptions="Center" />
                    <Border Grid.Column="1"
                            WidthRequest="40"
                            HeightRequest="40"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center"
                            SemanticProperties.Description="{loc:Translate Search_Messages}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSearchBarTapped" />
                        </Border.GestureRecognizers>
                        <Image Source="search.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Behaviors>
                                <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#2C342E, Dark=#E8EAED}" />
                            </Image.Behaviors>
                        </Image>
                    </Border>
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E8EDE6, Dark=#2A302C}" />
            </VerticalStackLayout>

            <!-- Selection Contextual Header -->
            <Grid IsVisible="{Binding IsSelectionMode}"
                  Margin="16,8,16,8"
                  HeightRequest="52"
                  ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                  ColumnSpacing="6"
                  VerticalOptions="Center">

                <!-- X (Cancel button) -->
                <Border Grid.Column="0"
                        WidthRequest="42"
                        HeightRequest="42"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 21"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnExitSelectionModeTapped" />
                    </Border.GestureRecognizers>
                    <Image Source="close.png"
                           WidthRequest="20"
                           HeightRequest="20"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           SemanticProperties.Description="{loc:Translate Chat_Cancel}">
                        <Image.Behaviors>
                            <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#1B1E24, Dark=#E8EAED}" />
                        </Image.Behaviors>
                    </Image>
                </Border>

                <!-- Count -->
                <Label Grid.Column="1"
                       Text="{Binding SelectedCountText}"
                       FontSize="18"
                       FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                       TextColor="{AppThemeBinding Light=#1B1E24, Dark=#E8EAED}"
                       VerticalOptions="Center"
                       HorizontalOptions="Start"
                       Margin="8,0,0,0" />

                <!-- Delete Icon -->
                <Border Grid.Column="2"
                        WidthRequest="42"
                        HeightRequest="42"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 21"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDeleteSelectedThreadsTapped" />
                    </Border.GestureRecognizers>
                    <Image Source="trash.png"
                           WidthRequest="21"
                           HeightRequest="21"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           SemanticProperties.Description="{loc:Translate Chat_Delete}">
                        <Image.Behaviors>
                            <behaviors:IconTintBehavior TintColor="#EF4444" />
                        </Image.Behaviors>
                    </Image>
                </Border>

                <!-- Archive Icon -->
                <Border Grid.Column="3"
                        WidthRequest="42"
                        HeightRequest="42"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 21"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnArchiveSelectedThreadsTapped" />
                    </Border.GestureRecognizers>
                    <Image Source="archive.png"
                           WidthRequest="21"
                           HeightRequest="21"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           SemanticProperties.Description="{loc:Translate Messages_Archive}">
                        <Image.Behaviors>
                            <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#1B1E24, Dark=#E8EAED}" />
                        </Image.Behaviors>
                    </Image>
                </Border>

                <!-- Three dot Icon -->
                <Border Grid.Column="4"
                        WidthRequest="42"
                        HeightRequest="42"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 21"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnThreeDotsTapped" />
                    </Border.GestureRecognizers>
                    <Image Source="morevert.png"
                           WidthRequest="21"
                           HeightRequest="21"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           SemanticProperties.Description="More options">
                        <Image.Behaviors>
                            <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#1B1E24, Dark=#E8EAED}" />
                        </Image.Behaviors>
                    </Image>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <CollectionView x:Name="ThreadsList"
                            Margin="8,4,8,0"
                            ItemsSource="{Binding Threads}"
                            ItemSizingStrategy="MeasureFirstItem"
                            SelectionMode="None"
                            Scrolled="OnThreadsScrolled"
                            VerticalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ThreadItem">
                    <Grid Padding="8,10"
                          HeightRequest="68"
                          ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="14"
                          HorizontalOptions="Fill"
                          BackgroundColor="{Binding RowBackgroundColor}"
                          behaviors:ThreadHoldBehavior.IsEnabled="True">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnThreadRowTapped" />
                        </Grid.GestureRecognizers>
                        <!-- Profile Picture / Selection Tick -->
                        <Border Grid.Column="0"
                                WidthRequest="46"
                                HeightRequest="46"
                                StrokeShape="RoundRectangle 23"
                                StrokeThickness="0"
                                Padding="0"
                                BackgroundColor="{Binding AvatarBgColor}"
                                InputTransparent="True">
                            <Grid InputTransparent="True" CascadeInputTransparent="True">
                                <Image IsVisible="{Binding ShowIcon}"
                                       Source="{Binding IconFile}"
                                       WidthRequest="24"
                                       HeightRequest="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True"
                                       SemanticProperties.Description="{Binding Name}">
                                    <Image.Behaviors>
                                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#1B5E43, Dark=#8FE0BE}" />
                                    </Image.Behaviors>
                                </Image>
                                <Label Text="{Binding Initials}"
                                       IsVisible="{Binding ShowInitials}"
                                       TextColor="{Binding AvatarTextColor}"
                                       FontSize="14"
                                       FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       InputTransparent="True" />

                                <!-- Selected State: White Tick on Primary Background -->
                                <Image Source="check.png"
                                       IsVisible="{Binding IsSelected}"
                                       WidthRequest="22"
                                       HeightRequest="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True">
                                    <Image.Behaviors>
                                        <behaviors:IconTintBehavior TintColor="White" />
                                    </Image.Behaviors>
                                </Image>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1"
                              RowDefinitions="Auto,Auto"
                              RowSpacing="3"
                              VerticalOptions="Center"
                              HorizontalOptions="Fill"
                              InputTransparent="True"
                              CascadeInputTransparent="True">
                            <Label Grid.Row="0"
                                   Text="{Binding Name}"
                                   TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                                   FontSize="14"
                                   FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Center"
                                   InputTransparent="True" />

                            <Label Grid.Row="1"
                                   Text="{Binding Preview}"
                                   FontSize="12"
                                   TextColor="{Binding PreviewColor}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Center"
                                   InputTransparent="True" />
                        </Grid>

                        <Grid Grid.Column="2"
                              RowDefinitions="Auto,Auto"
                              RowSpacing="6"
                              VerticalOptions="Center"
                              HorizontalOptions="End"
                              InputTransparent="True"
                              CascadeInputTransparent="True">
                            <Label Grid.Row="0"
                                   Text="{Binding Time}"
                                   FontSize="11"
                                   TextColor="{Binding TimeColor}"
                                   HorizontalOptions="End"
                                   InputTransparent="True" />
                            <Border Grid.Row="1"
                                    IsVisible="{Binding IsUnread}"
                                    Padding="7,1"
                                    StrokeShape="RoundRectangle 9"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource Primary}"
                                    HorizontalOptions="End"
                                    InputTransparent="True">
                                <Label Text="{Binding CountText}"
                                       FontSize="11"
                                       FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True" />
                            </Border>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Margin="0,0,24,24"
                WidthRequest="58"
                HeightRequest="58"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 29"
                BackgroundColor="{StaticResource Primary}"
                HorizontalOptions="End"
                VerticalOptions="End"
                IsVisible="{Binding IsNotSelectionMode}"
                SemanticProperties.Description="{loc:Translate Compose}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnComposeTapped" />
            </Border.GestureRecognizers>
            <Image Source="compose.png"
                   WidthRequest="24"
                   HeightRequest="24">
                <Image.Behaviors>
                    <behaviors:IconTintBehavior TintColor="White" />
                </Image.Behaviors>
            </Image>
        </Border>

        <!-- Not the default SMS app: Android keeps the inbox from working properly, so it is not shown -->
        <Grid x:Name="NotDefaultScreen"
              IsVisible="False"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkBackground}}">
            <!-- A background alone does not stop touches on Android; without this, taps reached the compose button under it -->
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnNotDefaultTapEater" />
            </Grid.GestureRecognizers>
            <VerticalStackLayout Padding="32,0" Spacing="10" VerticalOptions="Center">
                <Border WidthRequest="64"
                        HeightRequest="64"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 32"
                        BackgroundColor="{AppThemeBinding Light=#FCF2E1, Dark=#3A3020}"
                        HorizontalOptions="Center">
                    <Image Source="chat.png" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image.Behaviors>
                            <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#8A5A0E, Dark=#E8C27A}" />
                        </Image.Behaviors>
                    </Image>
                </Border>
                <Label Text="{loc:Translate Messages_NotDefaultTitle}"
                       Margin="0,6,0,0"
                       FontSize="18"
                       FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                       TextColor="{AppThemeBinding Light=#1B1E24, Dark=#E8EAED}"
                       HorizontalTextAlignment="Center" />
                <Label Text="{loc:Translate Messages_NotDefaultText}"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=#59615A, Dark=#9AA0AB}"
                       HorizontalTextAlignment="Center" />
                <Border Margin="0,12,0,0"
                        Padding="22,12"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        BackgroundColor="#2E6B4C"
                        HorizontalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSetDefaultTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="{loc:Translate Messages_NotDefaultAction}"
                           FontSize="15"
                           FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                           TextColor="White" />
                </Border>
            </VerticalStackLayout>
        </Grid>

        </Grid>

        </Grid>

        <!-- Dropdown Select Box Popup from Three dots -->
        <Grid x:Name="SelectBoxOverlay"
              IsVisible="False"
              BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseSelectBoxTapped" />
            </Grid.GestureRecognizers>
            <Border Margin="0,56,16,0"
                    Padding="4"
                    WidthRequest="200"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E2E8DF, Dark=#2A2E35}"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1F24}"
                    HorizontalOptions="End"
                    VerticalOptions="Start">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="16" Opacity="0.25" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSelectBoxTapEater" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="0">
                    <Grid Padding="12,11"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="10"
                          BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMarkAsUnreadTapped" />
                        </Grid.GestureRecognizers>
                        <Image Grid.Column="0"
                               Source="tabmessages.png"
                               WidthRequest="18"
                               HeightRequest="18"
                               VerticalOptions="Center">
                            <Image.Behaviors>
                                <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#1B1E24, Dark=#E8EAED}" />
                            </Image.Behaviors>
                        </Image>
                        <Label Grid.Column="1"
                               Text="{loc:Translate Messages_MarkAsUnread}"
                               FontSize="13"
                               FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                               TextColor="{AppThemeBinding Light=#1B1E24, Dark=#E8EAED}"
                               VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- SearchView and ChatView are created lazily by MessagesPage.xaml.cs so the inbox paints first. -->

    </Grid>
</ContentPage>
