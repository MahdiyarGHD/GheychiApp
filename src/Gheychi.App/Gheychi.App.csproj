<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>

        <OutputType>Exe</OutputType>
        <RootNamespace>Gheychi.App</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <ApplicationTitle>Gheychi</ApplicationTitle>

        <ApplicationId>com.evergreen.gheychiapp</ApplicationId>

        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    </PropertyGroup>

    <!-- Profiled AOT only precompiles the MAUI startup path; the rest of the app (opening a chat, the
         profile, search) was JIT-compiled the first time it ran, which showed as a pause. Larger APK. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <RunAOTCompilation>true</RunAOTCompilation>
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    </PropertyGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#05190F"/>

        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#05190F" BaseSize="128,128"/>

        <MauiImage Include="Resources\Images\*"/>
        <MauiFont Include="Resources\Fonts\*"/>
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0"/>
        <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
        <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.11" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Gheychi.Core\Gheychi.Core.csproj" />
        <ProjectReference Include="..\Gheychi.Infrastructure\Gheychi.Infrastructure.csproj" />
    </ItemGroup>

    <Import Project="..\..\build\SpamModel.targets" />

    <!-- A model fetched during this build missed the Resources\Raw glob, which was evaluated before it existed. -->
    <Target Name="IncludeFetchedSpamModel" AfterTargets="FetchSpamModel" Condition="'$(SpamModelFetched)' == 'true'">
        <ItemGroup>
            <_FetchedSpamModel Include="Resources\Raw\**" Exclude="@(MauiAsset)" />
            <MauiAsset Include="@(_FetchedSpamModel)" LogicalName="%(_FetchedSpamModel.RecursiveDir)%(_FetchedSpamModel.Filename)%(_FetchedSpamModel.Extension)" />
        </ItemGroup>
    </Target>

</Project>
