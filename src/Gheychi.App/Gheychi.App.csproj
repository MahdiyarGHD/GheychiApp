<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>

        <OutputType>Exe</OutputType>
        <RootNamespace>Gheychi.App</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <ApplicationTitle>Gheychi</ApplicationTitle>
        <ApplicationId>com.evergreen.gheychiapp</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AvaloniaNameGeneratorBehavior>InitializeComponent</AvaloniaNameGeneratorBehavior>
    </PropertyGroup>

    <!-- Full AOT: with profiled AOT only the startup path is precompiled and everything else (opening a chat, the
         profile, search) was JIT-compiled the first time it ran, which showed as a pause. Larger APK. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <RunAOTCompilation>true</RunAOTCompilation>
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
        <!-- Since .NET 9 only the 64-bit ABIs are built by default; older and low-end phones are 32-bit ARM.
             Not with -r: the SDK packages every ABI in RuntimeIdentifiers whenever it is set, ignoring the -r one. -->
        <RuntimeIdentifiers Condition="'$(RuntimeIdentifier)' == ''">android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="Gheychi.App" />
        <!-- Avalonia has its own Application, Button, Window...; the Android names are spelled out where used. -->
        <Using Remove="Android.App" />
        <Using Remove="Android.Widget" />
        <Using Remove="Android.Views" />
    </ItemGroup>

    <!-- The MAUI sources still waiting to be ported. -->
    <ItemGroup>
        <Compile Remove="_legacy\**" />
        <EmbeddedResource Remove="_legacy\**" />
        <AvaloniaXaml Remove="_legacy\**" />
        <AndroidResource Remove="_legacy\**" />
        <None Remove="_legacy\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="Avalonia.Android" Version="12.1.3" />
        <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.3" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
        <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
        <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.11" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Gheychi.Core\Gheychi.Core.csproj" />
        <ProjectReference Include="..\Gheychi.Infrastructure\Gheychi.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="UiAssets\**" />
    </ItemGroup>

    <Import Project="..\..\build\SpamModel.targets" />

    <!-- A model fetched during this build missed the Assets glob, which was evaluated before it existed. -->
    <Target Name="IncludeFetchedSpamModel" AfterTargets="FetchSpamModel" Condition="'$(SpamModelFetched)' == 'true'">
        <ItemGroup>
            <AndroidAsset Include="Assets\SpamModel\**" Exclude="@(AndroidAsset)" />
        </ItemGroup>
    </Target>

</Project>
