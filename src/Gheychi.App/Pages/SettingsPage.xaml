<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Gheychi.App.Localization"
             xmlns:vm="clr-namespace:Gheychi.App.ViewModels"
             xmlns:controls="clr-namespace:Gheychi.App.Controls"
             xmlns:settings="clr-namespace:Gheychi.App.Controls.Settings"
             xmlns:behaviors="clr-namespace:Gheychi.App.Behaviors"
             x:Class="Gheychi.App.Pages.SettingsPage"
             Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <settings:SettingsStyles />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- The screen behind each row is built when first opened and added over the overview, under the overlay -->
    <Grid x:Name="Root">
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="0,16,0,24">
                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border WidthRequest="56"
                                    HeightRequest="56"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18"
                                    BackgroundColor="#16382A"
                                    VerticalOptions="Start">
                                <Image Source="tabspam.png" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image.Behaviors>
                                        <behaviors:IconTintBehavior TintColor="#8FE0BE" />
                                    </Image.Behaviors>
                                </Image>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="Gheychi"
                                           FontSize="20"
                                           FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                                           TextColor="{AppThemeBinding Light=#1B1E24, Dark=#E8EAED}"
                                           VerticalOptions="Center" />
                                    <Border Padding="7,2"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="{AppThemeBinding Light=#E0E8DF, Dark=#203328}"
                                            VerticalOptions="Center">
                                        <Label x:Name="HeroVersion"
                                               FontSize="11"
                                               FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                                               TextColor="{AppThemeBinding Light=#59615A, Dark=#9AA0AB}" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Text="{loc:Translate Settings_Tagline}" Style="{StaticResource Note}" FontSize="13" />
                            </VerticalStackLayout>
                        </Grid>

                        <FlexLayout Wrap="Wrap" Margin="0,0,0,-8">
                            <Border x:Name="DefaultChip" Style="{StaticResource ChipOk}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDefaultChipTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="7">
                                    <BoxView x:Name="DefaultDot" Style="{StaticResource ChipDotOk}" />
                                    <Label x:Name="DefaultLabel" Style="{StaticResource ChipLabelOk}" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border x:Name="NotificationsChip" Style="{StaticResource ChipOk}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnNotificationsChipTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="7">
                                    <BoxView x:Name="NotificationsDot" Style="{StaticResource ChipDotOk}" />
                                    <Label x:Name="NotificationsLabel" Style="{StaticResource ChipLabelOk}" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border x:Name="ContactsChip" Style="{StaticResource ChipOk}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnContactsChipTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="7">
                                    <BoxView x:Name="ContactsDot" Style="{StaticResource ChipDotOk}" />
                                    <Label x:Name="ContactsLabel" Style="{StaticResource ChipLabelOk}" />
                                </HorizontalStackLayout>
                            </Border>
                        </FlexLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border Grid.Column="0" Style="{StaticResource Tile}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border WidthRequest="32" HeightRequest="32" StrokeThickness="0" StrokeShape="RoundRectangle 16" BackgroundColor="{AppThemeBinding Light=#F7F9FF, Dark=#14251B}" VerticalOptions="Center">
                                        <Image Source="shield.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Image.Behaviors>
                                                <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#1B5E43, Dark=#8FE0BE}" />
                                            </Image.Behaviors>
                                        </Image>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{loc:Translate Settings_TileModel}" Style="{StaticResource TileCaption}" />
                                        <Label x:Name="TileModelValue" Style="{StaticResource TileValue}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Tile}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCaughtTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border WidthRequest="32" HeightRequest="32" StrokeThickness="0" StrokeShape="RoundRectangle 16" BackgroundColor="{AppThemeBinding Light=#F7F9FF, Dark=#14251B}" VerticalOptions="Center">
                                        <Image Source="chart.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Image.Behaviors>
                                                <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#9A4A2A, Dark=#F0B79A}" />
                                            </Image.Behaviors>
                                        </Image>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{loc:Translate Settings_TileCaught}" Style="{StaticResource TileCaption}" />
                                        <Label x:Name="TileCaughtValue" Style="{StaticResource TileValue}" />
                                    </VerticalStackLayout>
                                    <Image Grid.Column="2" Style="{StaticResource Chevron}" WidthRequest="16" HeightRequest="16">
                                        <Image.Behaviors>
                                            <behaviors:IconTintBehavior TintColor="#8A8F98" />
                                        </Image.Behaviors>
                                    </Image>
                                </Grid>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{loc:Translate Settings_SectionProtection}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSpamTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource Badge}" BackgroundColor="{AppThemeBinding Light=#F5E4DA, Dark=#3A2A22}">
                                <Image Source="tabspam.png" Style="{StaticResource BadgeIcon}">
                                    <Image.Behaviors>
                                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#9A4A2A, Dark=#F0B79A}" />
                                    </Image.Behaviors>
                                </Image>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{loc:Translate Settings_Spam}" Style="{StaticResource RowTitle}" />
                                <Label x:Name="SpamHint" Style="{StaticResource RowSubtitle}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Style="{StaticResource Chevron}">
                                <Image.Behaviors>
                                    <behaviors:IconTintBehavior TintColor="#8A8F98" />
                                </Image.Behaviors>
                            </Image>
                        </Grid>
                        <VerticalStackLayout x:Name="SimsRow" IsVisible="False">
                            <BoxView Style="{StaticResource Divider}" />
                            <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSimsTapped" />
                                </Grid.GestureRecognizers>
                                <Border Style="{StaticResource Badge}" BackgroundColor="{AppThemeBinding Light=#D7EEDF, Dark=#1F4A35}">
                                    <Image Source="sim_card.png" Style="{StaticResource BadgeIcon}">
                                        <Image.Behaviors>
                                            <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#1B5E43, Dark=#8FE0BE}" />
                                        </Image.Behaviors>
                                    </Image>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{loc:Translate Settings_Sims}" Style="{StaticResource RowTitle}" />
                                    <Label x:Name="SimsHint" Style="{StaticResource RowSubtitle}" />
                                </VerticalStackLayout>
                                <Image Grid.Column="2" Style="{StaticResource Chevron}">
                                    <Image.Behaviors>
                                        <behaviors:IconTintBehavior TintColor="#8A8F98" />
                                    </Image.Behaviors>
                                </Image>
                            </Grid>
                        </VerticalStackLayout>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNotificationsTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource Badge}">
                                <Image Source="notifications.png" Style="{StaticResource BadgeIcon}">
                                    <Image.Behaviors>
                                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#33443C, Dark=#D9E3DD}" />
                                    </Image.Behaviors>
                                </Image>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{loc:Translate Settings_Notifications}" Style="{StaticResource RowTitle}" />
                                <Label Text="{loc:Translate Settings_NotificationsHint}" Style="{StaticResource RowSubtitle}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Style="{StaticResource Chevron}">
                                <Image.Behaviors>
                                    <behaviors:IconTintBehavior TintColor="#8A8F98" />
                                </Image.Behaviors>
                            </Image>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{loc:Translate Settings_SectionPersonal}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAppearanceTapped" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource Badge}">
                            <Image Source="palette.png" Style="{StaticResource BadgeIcon}">
                                <Image.Behaviors>
                                    <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#33443C, Dark=#D9E3DD}" />
                                </Image.Behaviors>
                            </Image>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="{loc:Translate Settings_Appearance}" Style="{StaticResource RowTitle}" />
                            <Label Text="{loc:Translate Settings_AppearanceHint}" Style="{StaticResource RowSubtitle}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Style="{StaticResource Chevron}">
                            <Image.Behaviors>
                                <behaviors:IconTintBehavior TintColor="#8A8F98" />
                            </Image.Behaviors>
                        </Image>
                    </Grid>
                </Border>

                <Label Text="{loc:Translate Settings_SectionPrivacy}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPrivacyTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource Badge}" BackgroundColor="{AppThemeBinding Light=#F4ECD4, Dark=#332D1C}">
                                <Image Source="lock.png" Style="{StaticResource BadgeIcon}">
                                    <Image.Behaviors>
                                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#8A6A12, Dark=#E5C66B}" />
                                    </Image.Behaviors>
                                </Image>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{loc:Translate Settings_Privacy}" Style="{StaticResource RowTitle}" />
                                <Label Text="{loc:Translate Settings_PrivacyHint}" Style="{StaticResource RowSubtitle}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Style="{StaticResource Chevron}">
                                <Image.Behaviors>
                                    <behaviors:IconTintBehavior TintColor="#8A8F98" />
                                </Image.Behaviors>
                            </Image>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="Auto,*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAboutTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource Badge}">
                                <Image Source="info.png" Style="{StaticResource BadgeIcon}">
                                    <Image.Behaviors>
                                        <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#33443C, Dark=#D9E3DD}" />
                                    </Image.Behaviors>
                                </Image>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{loc:Translate Settings_About}" Style="{StaticResource RowTitle}" />
                                <Label x:Name="AboutHint" Style="{StaticResource RowSubtitle}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Style="{StaticResource Chevron}">
                                <Image.Behaviors>
                                    <behaviors:IconTintBehavior TintColor="#8A8F98" />
                                </Image.Behaviors>
                            </Image>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Margin="24,28,24,0" Spacing="4" HorizontalOptions="Center">
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Image Source="shield.png" WidthRequest="15" HeightRequest="15" VerticalOptions="Center">
                            <Image.Behaviors>
                                <behaviors:IconTintBehavior TintColor="{AppThemeBinding Light=#3A453D, Dark=#C9D2CB}" />
                            </Image.Behaviors>
                        </Image>
                        <Label Text="{loc:Translate Settings_FooterTitle}"
                               FontSize="13"
                               FontFamily="{x:Static vm:ThreadItem.FontFamilyBold}"
                               TextColor="{AppThemeBinding Light=#3A453D, Dark=#C9D2CB}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="{loc:Translate Settings_FooterText}"
                           FontSize="12"
                           TextColor="#8A8F98"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <controls:SpamOverlay x:Name="Overlay" />
    </Grid>
</ContentPage>
