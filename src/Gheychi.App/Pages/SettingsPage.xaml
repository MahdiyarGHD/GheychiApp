                            </Grid>
                            <BoxView Style="{StaticResource Divider}" Margin="16,0" />
                            <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnComingSoonTapped" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                    <Label Text="{loc:Translate Settings_Licenses}" Style="{StaticResource RowTitle}" />
                                    <Label Text="{loc:Translate Settings_LicensesHint}" Style="{StaticResource RowSubtitle}" />
                                </VerticalStackLayout>
                                <Image Grid.Column="1" Style="{StaticResource Chevron}">
                                    <Image.Behaviors>
                                        <behaviors:IconTintBehavior TintColor="#8A8F98" />
                                    </Image.Behaviors>
                                </Image>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <controls:SpamOverlay x:Name="Overlay" />
    </Grid>
</ContentPage>
