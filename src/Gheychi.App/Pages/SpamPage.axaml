<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Gheychi.App"
             xmlns:loc="clr-namespace:Gheychi.App.Localization"
             xmlns:theme="clr-namespace:Gheychi.App.Theming"
             xmlns:ui="clr-namespace:Gheychi.App.Ui"
             xmlns:vm="clr-namespace:Gheychi.App.ViewModels"
             xmlns:controls="clr-namespace:Gheychi.App.Controls"
             x:Class="Gheychi.App.Pages.SpamPage"
             x:DataType="vm:SpamViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- App header -->
        <Grid x:Name="AppHeader" Grid.Row="0" Margin="22,10,10,12" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0"
                       Text="Gheychi"
                       FontSize="22"
                       FontFamily="{x:Static app:AppFonts.Bold}"
                       Foreground="{theme:ThemeBrush Light=#000000, Dark=#FFFFFF}"
                       VerticalAlignment="Center" />
            <Border Grid.Column="1"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    Background="Transparent"
                    VerticalAlignment="Center"
                    Tapped="OnSettingsTapped"
                    AutomationProperties.Name="{loc:Translate Tab_Settings}">
                <ui:Icon Data="{StaticResource Icon.TabSettings}" Width="20" Height="20" Foreground="{theme:ThemeBrush Light=#2E3032, Dark=#E8EAED}" />
            </Border>
            <Border Grid.Column="2"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    Background="Transparent"
                    VerticalAlignment="Center"
                    Tapped="OnSearchTapped"
                    AutomationProperties.Name="{loc:Translate Spam_SearchHint}">
                <ui:Icon Data="{StaticResource Icon.Search}" Width="20" Height="20" Foreground="{theme:ThemeBrush Light=#2E3032, Dark=#E8EAED}" />
            </Border>
        </Grid>

        <!-- Search bar, in place of the header while searching -->
        <Border x:Name="SearchBar"
                Grid.Row="0"
                IsVisible="False"
                Margin="12,6"
                Padding="12,0,4,0"
                Height="42"
                CornerRadius="21"
                Background="{theme:ThemeBrush Light=#E8EAED, Dark=#1C1F24}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <ui:Icon Grid.Column="0" Data="{StaticResource Icon.Search}" Width="18" Height="18" Margin="0,0,8,0" Foreground="{theme:ThemeBrush Light=#595C61, Dark=#9AA0AB}" />
                <TextBox x:Name="SearchEntry"
                         Grid.Column="1"
                         Classes="plain"
                         Text="{Binding SearchText}"
                         PlaceholderText="{loc:Translate Spam_SearchHint}"
                         FontSize="14"
                         Foreground="{theme:ThemeBrush Light=#000000, Dark=#FFFFFF}"
                         TextInputOptions.ReturnKeyType="Search"
                         VerticalAlignment="Center" />
                <Border Grid.Column="2"
                        Width="34"
                        Height="34"
                        Margin="8,0,0,0"
                        CornerRadius="17"
                        Background="Transparent"
                        VerticalAlignment="Center"
                        Tapped="OnSearchCloseTapped">
                    <ui:Icon Data="{StaticResource Icon.Close}" Width="16" Height="16" Foreground="{theme:ThemeBrush Light=#595C61, Dark=#9AA0AB}" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Grid.RowSpan="2"
                CornerRadius="28,28,0,0"
                ClipToBounds="True"
                Background="{theme:ThemeBrush Light=#FFFFFF, Dark=#1E1F22}">
        <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" Margin="22,20,10,6" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="{loc:Translate Spam_PageTitle}"
                           FontSize="22"
                           FontFamily="{x:Static app:AppFonts.Bold}"
                           Foreground="{theme:ThemeBrush Light=#000000, Dark=#FFFFFF}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Text="{loc:Translate Spam_ClearAll}"
                           IsVisible="{Binding HasAny}"
                           FontSize="13"
                           FontFamily="{x:Static app:AppFonts.Bold}"
                           Foreground="{theme:AccentBrush Role=Text}"
                           Padding="8,6"
                           Background="Transparent"
                           VerticalAlignment="Center"
                           Tapped="OnClearAllTapped" />
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Margin="0,2,0,0"
                           Text="{Binding Subtitle}"
                           FontSize="12"
                           Foreground="#8A8F98" />
            </Grid>
        <Panel Grid.Row="1">
        <ItemsControl x:Name="SpamList"
                      Margin="0,4,0,0"
                      ItemsSource="{Binding Items}">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <vm:SpamTemplateSelector>
                    <vm:SpamTemplateSelector.DateSeparatorTemplate>
                        <DataTemplate x:DataType="vm:DateSeparatorItem">
                            <TextBlock Text="{Binding Text}"
                                       Padding="22,10,0,2"
                                       FontSize="12"
                                       FontFamily="{x:Static app:AppFonts.Bold}"
                                       Foreground="{theme:AccentBrush Role=Text}" />
                        </DataTemplate>
                    </vm:SpamTemplateSelector.DateSeparatorTemplate>
                    <vm:SpamTemplateSelector.SpamTemplate>
                        <DataTemplate x:DataType="vm:SpamItem">
                            <!-- One flat grid per row: the avatar spans both lines, the more button sits at the end. -->
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                <Border Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="0"
                                        Width="40"
                                        Height="40"
                                        Margin="16,10,12,0"
                                        CornerRadius="20"
                                        Background="{theme:ThemeBrush Light=#FCF0DC, Dark=#3A3020}"
                                        VerticalAlignment="Top">
                                    <ui:Icon Data="{StaticResource Icon.SpamAlert}" Width="21" Height="21" Foreground="{theme:ThemeBrush Light=#A8660A, Dark=#E8C27A}" />
                                </Border>

                                <!-- The sender gives way first; the confidence and time are always shown whole -->
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Margin="0,9,8,0"
                                           Text="{Binding Sender}"
                                           ui:TextDirection.KeepSide="True"
                                           FontSize="15"
                                           FontFamily="{x:Static app:AppFonts.Bold}"
                                           Foreground="{theme:ThemeBrush Light=#000000, Dark=#FFFFFF}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Margin="0,9,8,0"
                                           Text="{Binding Confidence}"
                                           FontSize="11.5"
                                           FontFamily="{x:Static app:AppFonts.Bold}"
                                           Foreground="{Binding ConfidenceColor}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="3"
                                           Margin="0,9,12,0"
                                           Text="{Binding Clock}"
                                           FontSize="11.5"
                                           Foreground="#8A8F98"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="3"
                                           Margin="0,1,12,9"
                                           Text="{Binding Preview}"
                                           ui:TextDirection.KeepSide="True"
                                           FontSize="13.5"
                                           Foreground="{theme:ThemeBrush Light=#5E6166, Dark=#9AA0AB}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap"
                                           MaxLines="2" />

                                <Border Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="4"
                                        Width="34"
                                        Height="34"
                                        CornerRadius="17"
                                        Background="Transparent"
                                        VerticalAlignment="Center"
                                        Tapped="OnMoreTapped">
                                    <ui:Icon Data="{StaticResource Icon.More}" Width="18" Height="18" Foreground="{theme:ThemeBrush Light=#8A8F98, Dark=#9AA0AB}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </vm:SpamTemplateSelector.SpamTemplate>
                </vm:SpamTemplateSelector>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel x:Name="EmptyState"
                    Margin="12,64,4,0"
                    Spacing="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    IsVisible="False">
            <Border Width="56"
                    Height="56"
                    CornerRadius="28"
                    Background="{theme:ThemeBrush Light=#E9EAEB, Dark=#2D2E30}"
                    HorizontalAlignment="Center">
                <ui:Icon Data="{StaticResource Icon.Shield}" Width="24" Height="24" Foreground="{theme:AccentBrush Role=Text}" />
            </Border>
            <TextBlock Text="{loc:Translate Spam_Placeholder}"
                       FontSize="13"
                       Foreground="#8A8F98"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>
        </Panel>
        </Grid>
        </Border>

        <controls:SpamOverlay x:Name="Overlay" Grid.RowSpan="4" />
    </Grid>
</UserControl>
