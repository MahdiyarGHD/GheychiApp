<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch window, shown before the app has drawn. Its colours come from values / values-night, so it is the
         page background of the light or dark theme; on Android 12+ the system splash uses the same colour. -->
    <style name="Gheychi.Splash" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
    </style>
</resources>
